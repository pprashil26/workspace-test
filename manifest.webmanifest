<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>Workspace</title>
<meta name="description" content="A simple local-first work task and linked notes app.">
<meta name="theme-color" content="#f6f7f5">
<style>
:root{--bg:#c7cdc6;--page:#fff;--panel:#fafbf9;--ink:#30352f;--muted:#6f766d;--line:#dfe4df;--soft:#f1f3f0;--entry:#edf4f0;--entry-border:#b8cec2;--selected:#d7e7de;--accent:#e8d998;--danger:#9a5d57;--shadow:0 10px 26px rgba(46,57,50,.08);--radius:16px;--card-radius:11px}
*{box-sizing:border-box}[hidden]{display:none!important}html{min-height:100%}body{margin:0;min-height:100vh;background:var(--bg);color:var(--ink);font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Arial,sans-serif;font-size:13px;line-height:1.4;padding:12px}button,input,textarea,select{font:inherit;color:inherit}button{cursor:pointer}.plain-btn,.icon-btn{border:0;background:transparent;color:var(--muted);border-radius:9px;min-height:32px}.plain-btn{padding:5px 8px}.plain-btn:hover,.icon-btn:hover{background:var(--soft);color:var(--ink)}.icon-btn{width:32px;padding:0;display:inline-flex;align-items:center;justify-content:center}.primary-btn{border:1px solid #d8c76e;background:#f8eaa2;color:#4f4518;border-radius:10px;min-height:34px;padding:5px 12px;font-weight:700}.primary-btn:hover{background:#f3df7d}.danger{color:var(--danger)!important}.shell{width:min(794px,calc(100vw - 24px));min-height:calc(100vh - 24px);margin:auto;background:var(--page);border:1px solid var(--line);border-radius:var(--radius);box-shadow:var(--shadow);overflow:hidden;display:flex;flex-direction:column}.app-head{min-height:52px;padding:9px 12px;border-bottom:1px solid var(--line);background:linear-gradient(180deg,#fff 0%,#f6f8f5 100%);display:flex;align-items:center;justify-content:space-between;gap:10px}.brand{font-size:17px;font-weight:700}.head-actions{display:flex;align-items:center;gap:4px;flex-wrap:wrap}.search-bar{padding:8px 12px;border-bottom:1px solid var(--line);background:var(--panel)}.search-bar input,.field{width:100%;min-height:36px;border:1px solid var(--line);border-radius:10px;background:#fff;padding:7px 10px;outline:0}.search-bar input:focus,.field:focus{border-color:var(--entry-border);background:var(--entry);box-shadow:0 0 0 2px rgba(184,206,194,.25)}.tabs{display:flex;align-items:center;gap:4px;padding:7px 10px;border-bottom:1px solid var(--line);background:#fff}.tab{border:1px solid var(--line);background:#fff;color:var(--muted);border-radius:9px;min-height:32px;padding:5px 12px;font-weight:650}.tab.active{background:var(--selected);border-color:var(--entry-border);color:var(--ink)}.main{flex:1;min-height:0}.view{padding:10px 12px 14px}.toolbar{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-bottom:8px}.toolbar-title{font-size:14px;font-weight:700}.toolbar-actions{display:flex;align-items:center;gap:5px}.list-tabs,.filters{display:flex;align-items:center;gap:5px;overflow-x:auto;scrollbar-width:none;padding-bottom:7px}.list-tabs::-webkit-scrollbar,.filters::-webkit-scrollbar{display:none}.chip{flex:0 0 auto;border:1px solid var(--line);background:#fff;color:var(--muted);border-radius:999px;min-height:29px;padding:4px 9px}.chip.active{background:var(--selected);border-color:var(--entry-border);color:var(--ink);font-weight:700}.filters{border-top:1px solid var(--line);padding-top:7px}.filter{flex:0 0 auto;border:0;background:transparent;color:#a3aaa1;min-height:26px;padding:2px 4px;font-size:11px}.filter.active{color:var(--ink);font-weight:700;text-decoration:underline;text-underline-offset:4px}.filter-divider{flex:0 0 auto;width:1px;height:16px;margin:0 3px;background:var(--line)}.list{display:grid;gap:5px}.task-card{display:grid;grid-template-columns:30px 30px minmax(0,1fr) auto;align-items:start;gap:5px;padding:6px;border:1px solid var(--line);border-radius:var(--card-radius);background:#fff}.task-card.highlighted{border-color:#c9b96e;box-shadow:inset 3px 0 0 #c9b96e}.task-card.event{border-color:#8fb9df;box-shadow:inset 3px 0 0 #8fb9df;background:#f7fbff}.task-status,.task-highlight{width:30px;height:30px;border:0;background:transparent;border-radius:8px;color:var(--muted)}.task-status:hover,.task-highlight:hover{background:var(--soft)}.task-main{min-width:0;padding:4px 0}.task-title{font-size:13px;font-weight:600;overflow-wrap:anywhere}.task-card.done .task-title{text-decoration:line-through;color:var(--muted)}.task-next,.task-meta{margin-top:2px;color:var(--muted);font-size:10.5px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.task-actions{display:flex;align-items:center;gap:1px}.empty{padding:28px 10px;text-align:center;color:var(--muted)}.notes-list{display:grid;gap:5px}.note-row{display:grid;grid-template-columns:32px minmax(0,1fr) auto;align-items:center;gap:6px;min-height:42px;padding:4px 7px;border:1px solid var(--line);border-radius:var(--card-radius);background:#fff;cursor:pointer}.note-row.pinned{border-color:#c9b96e;box-shadow:inset 3px 0 0 #c9b96e}.note-name{font-weight:650;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.note-preview{color:var(--muted);font-size:10.5px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.note-links{color:var(--muted);font-size:10px;white-space:nowrap}.modal{position:fixed;inset:0;z-index:100;display:none;align-items:center;justify-content:center;padding:16px;background:rgba(48,53,47,.28);backdrop-filter:blur(1px)}.modal.open{display:flex}.dialog{width:min(430px,94vw);max-height:90vh;background:var(--page);border:1px solid var(--line);border-radius:18px;box-shadow:0 18px 50px rgba(35,45,38,.22);overflow:hidden;display:flex;flex-direction:column}.dialog.wide{width:min(650px,94vw)}.dialog-head{min-height:48px;padding:8px 12px;border-bottom:1px solid var(--line);background:var(--panel);display:flex;align-items:center;justify-content:space-between;gap:8px}.dialog-title{font-weight:700}.dialog-body{padding:12px;display:grid;gap:8px;overflow-y:auto}.dialog-actions{padding:8px 12px 12px;display:flex;align-items:center;gap:7px}.dialog-actions .spacer{flex:1}.field-group{display:grid;gap:4px}.field-group label{color:var(--muted);font-size:11px;font-weight:650}.row-2{display:grid;grid-template-columns:1fr 1fr;gap:8px}.check-line{display:flex;align-items:center;gap:8px;min-height:32px}.note-body{min-height:320px;resize:vertical;line-height:26px;background-color:#fff;background-image:repeating-linear-gradient(to bottom,transparent 0,transparent 25px,rgba(160,145,120,.18) 26px)}.related{border-top:1px solid var(--line);padding-top:8px}.related-title{font-size:11px;font-weight:700;color:var(--muted);margin-bottom:5px}.related-list{display:grid;gap:4px}.related-item{display:flex;align-items:center;justify-content:space-between;gap:6px;border:1px solid var(--line);border-radius:9px;background:#fff;padding:5px 7px}.related-open{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;text-align:left}.backup-input{display:none}.help{padding-left:18px;margin:4px 0}.footer{padding:7px 12px;border-top:1px solid var(--line);background:var(--panel);color:var(--muted);font-size:10.5px;text-align:center}.toast{position:fixed;left:50%;bottom:20px;transform:translate(-50%,12px);z-index:200;opacity:0;pointer-events:none;padding:8px 13px;border:1px solid #9bb6a7;border-radius:999px;background:#eef7f1;color:#315445;font-weight:700;transition:.16s}.toast.show{opacity:1;transform:translate(-50%,0)}
@media(max-width:759px){body{padding:6px;background:#f6f7f5}.shell{width:100%;min-height:calc(100vh - 12px);border-radius:14px}.app-head{padding:8px 10px}.brand{font-size:16px}.head-actions .desktop-label{display:none}.search-bar,.view{padding-left:9px;padding-right:9px}.tabs{position:sticky;top:0;z-index:5}.tab{flex:1}.task-card{grid-template-columns:30px 30px minmax(0,1fr) 32px}.task-actions .secondary-action{display:none}.row-2{grid-template-columns:1fr}.dialog{width:calc(100vw - 12px);max-height:92dvh}.dialog.wide{width:calc(100vw - 12px)}.note-body{min-height:48dvh;font-size:16px}.field{font-size:16px}.modal{padding:6px}}

/* Compact navigation alignment */
.brand-nav{display:flex;align-items:center;gap:12px;min-width:0}.app-head .tabs{padding:0;border:0;background:transparent}.app-head .tab{min-height:30px;padding:4px 10px}.task-toolbar{justify-content:flex-start;margin-bottom:8px;min-width:0;overflow:hidden}.task-toolbar .toolbar-title{flex:0 0 auto}.task-toolbar .list-tabs,.task-toolbar .filters{padding:0;overflow-x:auto}.task-toolbar .list-tabs{flex:0 1 auto}.task-toolbar .filters{flex:1 1 auto;border:0;padding:0 0 0 7px;border-left:1px solid var(--line)}.task-toolbar .primary-btn{flex:0 0 auto;margin-left:auto}.task-toolbar .chip{min-height:25px;padding:2px 4px;font-size:11px;border:0;background:transparent;color:#a3aaa1}.task-toolbar .chip.active{color:var(--ink);font-weight:700;text-decoration:underline;text-underline-offset:4px;background:transparent;border:0}.task-toolbar .filter{min-height:25px;padding:2px 3px}.archived-footer{color:#a3aaa1!important}
@media(max-width:759px){.app-head{align-items:flex-start;flex-wrap:wrap}.brand-nav{width:100%;display:grid;grid-template-columns:auto minmax(0,1fr);gap:8px}.app-head .tabs{min-width:0}.app-head .tab{min-height:32px}.head-actions{width:100%;justify-content:flex-end}.task-toolbar{display:grid;grid-template-columns:1fr auto;overflow:visible}.task-toolbar .toolbar-title{grid-column:1}.task-toolbar .primary-btn{grid-column:2;grid-row:1}.task-toolbar .list-tabs{grid-column:1/-1;grid-row:2;padding-top:7px}.task-toolbar .filters{grid-column:1/-1;grid-row:3;border-left:0;border-top:1px solid var(--line);padding:7px 0 0}.task-toolbar .chip{min-height:26px;padding:2px 4px;font-size:11px}.task-toolbar .filter{min-height:26px;padding:2px 4px}}
.task-card{padding:3px 6px!important;gap:3px!important;grid-template-columns:24px 24px minmax(0,1fr) auto!important}.task-status,.task-highlight,.icon-btn{width:24px;height:24px;min-height:24px}.task-main{padding:1px 0!important}.task-title{font-size:12px}.task-next{font-size:10px;margin-top:1px}.task-meta{font-size:10px;margin-top:0}.list{gap:3px!important}@media(min-width:760px){.capture-action{display:none}}
.shortcut-bar{display:flex;align-items:center;justify-content:center;gap:14px;flex-wrap:wrap;padding:5px 10px;border-bottom:1px solid var(--line);background:#f7f8f6;color:var(--muted);font-size:10.5px;font-weight:600}.shortcut-bar span{white-space:nowrap}.shortcut-bar kbd{display:inline-block;min-width:18px;padding:1px 4px;border:1px solid #cfd5cf;border-bottom-color:#b7beb7;border-radius:4px;background:#fff;color:var(--ink);font:600 10px/1.35 inherit;text-align:center;box-shadow:0 1px 0 rgba(48,53,47,.08)}@media(max-width:759px){.shortcut-bar{gap:8px;padding:4px 6px;font-size:9.5px}.shortcut-bar kbd{font-size:9px}}
@media(min-width:760px){.capture-action{display:none!important}.app-head{min-height:42px;padding:6px 12px}.brand{display:none}.brand-nav{gap:6px}.app-head .tabs{padding:0;border:0;background:transparent}.app-head .tab{border:0;background:transparent;padding:4px 8px;min-height:28px}.head-actions{margin-left:auto}.search-bar{padding:6px 12px}}.shortcut-inline{display:flex;align-items:center;gap:4px;color:var(--muted);font-size:10px;font-weight:600}.shortcut-inline kbd{display:inline-block;padding:1px 4px;border:1px solid #cfd5cf;border-radius:4px;background:#fff;color:var(--ink)}@media(max-width:759px){.shortcut-inline{display:none}}
/* Compact navigation and footer utilities */
.footer{display:flex;align-items:center;justify-content:center;gap:8px;flex-wrap:wrap;padding:3px 10px}.footer-actions{display:flex;align-items:center;gap:1px}.footer .plain-btn{min-height:24px;padding:2px 5px;font-size:10.5px}@media(min-width:760px){.app-head{min-height:34px;padding:3px 10px;justify-content:center}.brand-nav{gap:0}.app-head .tab{min-height:26px;padding:2px 10px}.head-actions{display:none}}@media(max-width:759px){.footer{gap:2px 6px}.footer-actions{flex-wrap:wrap;justify-content:center}}
.journal-capture{display:flex;align-items:center;gap:6px;padding:5px 10px;border-bottom:1px solid var(--line);background:var(--panel)}.journal-capture input{flex:1;min-width:0;min-height:30px;border:1px solid var(--line);border-radius:9px;padding:4px 8px;outline:0}.journal-capture input:focus{border-color:var(--entry-border);background:var(--entry)}.journal-capture .plain-btn,.journal-capture .primary-btn{min-height:30px;padding:3px 8px}@media(max-width:759px){.journal-capture{padding:5px 8px}.journal-capture input{font-size:16px}}
/* Fixed app chrome: only the main content area scrolls */
body{height:100vh;height:100dvh;overflow:hidden}.shell{height:calc(100vh - 24px);height:calc(100dvh - 24px);min-height:0}.app-head,.search-bar,.journal-capture,.footer{flex:0 0 auto}.main{flex:1 1 auto;min-height:0;overflow-y:auto;overscroll-behavior:contain}@media(max-width:759px){body{height:100vh;height:100dvh;overflow:hidden}.shell{height:calc(100vh - 12px);height:calc(100dvh - 12px);min-height:0}}
.count{margin-left:3px;color:#a3aaa1;font-size:9.5px;font-weight:500}.active .count{color:inherit;opacity:.72}
.active-filter-indicator{display:none;align-items:center;gap:5px;width:max-content;max-width:100%;margin:0 0 6px 2px;padding:3px 7px;border:1px solid var(--entry-border);border-radius:999px;background:var(--entry);color:var(--ink);font-size:10px;font-weight:650}.active-filter-indicator.visible{display:flex}.active-filter-indicator button{display:inline-flex;align-items:center;justify-content:center;width:20px;height:20px;padding:0;border:0;border-radius:50%;background:transparent;color:var(--muted);font-size:14px;line-height:1}.active-filter-indicator button:hover{background:var(--selected);color:var(--ink)}
@media(max-width:759px){.task-status,.task-highlight,.task-actions .icon-btn{width:40px;height:40px;min-height:40px}.task-card{grid-template-columns:40px 40px minmax(0,1fr) auto!important;align-items:center}.task-main{align-self:center}.task-toolbar .chip,.task-toolbar .filter{min-height:38px;padding:6px 8px}.note-row{min-height:48px}.note-row .icon-btn{width:40px;height:40px;min-height:40px}.footer .plain-btn{min-height:36px;padding:6px 8px}.active-filter-indicator button{width:30px;height:30px;min-height:30px}}

.compact-tabs{display:flex;align-items:center;gap:10px}.compact-tabs .tab{border:0!important;background:transparent!important;padding:2px 4px!important;min-height:24px!important;color:#8a9188;font-weight:600}.compact-tabs .tab.active{color:var(--ink)!important;text-decoration:underline;text-underline-offset:4px}.compact-actions{display:flex;align-items:center;gap:2px}.compact-actions .plain-btn{min-height:24px;padding:2px 6px;font-size:12px;color:#8a9188}.compact-actions .plain-btn:hover{background:transparent;color:var(--ink)}.app-head{min-height:30px!important;padding:2px 8px!important}.brand{display:none!important}.brand-nav{display:flex!important;align-items:center!important;justify-content:space-between;width:100%;gap:6px}@media(max-width:759px){.app-head{flex-wrap:nowrap!important}.brand-nav{display:flex!important;align-items:center!important}.compact-tabs .tab{min-height:24px!important}.compact-actions .plain-btn{min-height:24px;padding:2px 5px}}@media(max-width:759px){.app-head{padding-top:max(6px, env(safe-area-inset-top))!important}.shell{margin-top:max(18px, env(safe-area-inset-top));height:calc(100dvh - 12px - max(18px, env(safe-area-inset-top)))!important}}
/* Mobile-only compact single-row task lists and filters */
@media(max-width:759px){
.task-toolbar{display:flex!important;align-items:center!important;gap:0!important;margin-bottom:4px!important;overflow-x:auto!important;overflow-y:hidden!important;scrollbar-width:none;white-space:nowrap;-webkit-overflow-scrolling:touch}
.task-toolbar::-webkit-scrollbar{display:none}
.task-toolbar .list-tabs,.task-toolbar .filters{display:flex!important;flex:0 0 auto!important;align-items:center!important;gap:2px!important;overflow:visible!important;padding:0!important;border:0!important}
.task-toolbar .filters:before{content:"";flex:0 0 auto;width:1px;height:13px;margin:0 4px;background:var(--line)}
.task-toolbar .filter-divider{display:none!important}
.task-toolbar .chip,.task-toolbar .filter{min-height:24px!important;height:24px!important;padding:1px 4px!important;font-size:10px!important;line-height:22px!important;border:0!important;border-radius:0!important;background:transparent!important}
.task-toolbar .chip.active,.task-toolbar .filter.active{background:transparent!important;color:var(--ink)!important;font-weight:700!important;text-decoration:underline!important;text-underline-offset:3px!important}
.task-toolbar .count{margin-left:1px!important;font-size:8px!important;font-weight:500!important;opacity:.68}
}

/* Desktop-only persistent sticky note panel */
.sticky-note-panel{display:none}
@media(min-width:1000px){
body{padding-right:284px}
.shell{margin-left:auto;margin-right:auto}
.sticky-note-panel{position:fixed;top:12px;right:12px;bottom:12px;z-index:80;display:flex;flex-direction:column;width:260px;border:1px solid #d8c76e;border-radius:14px;background:#fffdf2;box-shadow:var(--shadow);overflow:hidden}
.sticky-note-panel.collapsed{bottom:auto;width:44px;height:40px}
.sticky-note-head{display:flex;align-items:center;justify-content:space-between;gap:6px;min-height:40px;padding:4px 6px 4px 10px;border-bottom:1px solid #eadf9e;background:#fff8cf}
.sticky-note-title{font-size:11px;font-weight:750;color:#5b5125;white-space:nowrap}
.sticky-note-toggle{flex:0 0 auto;width:30px;height:30px;min-height:30px;border:0;border-radius:8px;background:transparent;color:#746a38}
.sticky-note-toggle:hover{background:rgba(216,199,110,.2)}
.sticky-note-panel.collapsed .sticky-note-title,.sticky-note-panel.collapsed .sticky-note-body{display:none}
.sticky-note-body{flex:1;min-height:0;display:flex;flex-direction:column}
.sticky-note-text{flex:1;width:100%;min-height:0;padding:10px;border:0;outline:0;resize:none;background:#fffdf2;color:var(--ink);font:13px/1.55 inherit}
.sticky-note-status{padding:4px 9px;border-top:1px solid #eee5b6;color:#92885a;font-size:9.5px;text-align:right}
}

/* Centered Workspace and shared mobile Sticky Note access */
@media(min-width:1000px){body{padding-right:12px}.shell{margin-left:auto;margin-right:auto}}
.mobile-sticky-btn{display:none}
@media(max-width:999px){
.mobile-sticky-btn{display:inline-flex}
.mobile-sticky-modal .dialog{width:min(520px,calc(100vw - 12px));height:min(72dvh,560px)}
.mobile-sticky-modal .dialog-body{display:flex;flex:1;min-height:0;padding:8px}
.mobile-sticky-text{flex:1;width:100%;min-height:0;border:1px solid var(--line);border-radius:10px;padding:10px;resize:none;outline:0;background:#fffdf2;font-size:16px;line-height:1.5}
.mobile-sticky-text:focus{border-color:#d8c76e;box-shadow:0 0 0 2px rgba(216,199,110,.2)}
}

@media(max-width:999px){.mobile-sticky-btn{display:inline-flex!important;align-items:center;justify-content:center;background:#fff4c7!important;border:1px solid #eadb8c!important;border-radius:8px!important;color:#6b5f25!important;font-weight:700!important;flex:0 0 auto}.footer-actions{flex-wrap:wrap!important}.mobile-sticky-btn:hover{background:#ffefb0!important}}
.task-note-actions{display:flex;align-items:center;gap:4px;flex-wrap:wrap}.task-note-actions .plain-btn{min-height:28px;padding:3px 7px;font-size:11px}.task-note-linked{color:var(--muted);font-size:10.5px}@media(max-width:759px){.task-note-actions{gap:2px}.task-note-actions .plain-btn{min-height:36px;padding:5px 7px}}

/* Compact Add Task scheduling and options layout */
.task-schedule-row{display:grid;grid-template-columns:minmax(0,1.25fr) minmax(0,1fr) 86px;gap:8px;align-items:end}
.task-options-row{display:flex;align-items:center;gap:18px;flex-wrap:wrap;min-height:30px}
.task-options-row .check-line{min-height:30px;margin:0;white-space:nowrap}
.task-estimate-field .field{text-align:center;padding-left:6px;padding-right:6px}
@media(max-width:759px){.task-schedule-row{grid-template-columns:minmax(0,1.25fr) minmax(0,1fr) 72px;gap:5px}.task-schedule-row .field{min-width:0;padding-left:6px;padding-right:6px}.task-options-row{gap:12px}.task-options-row .check-line{font-size:12px}}

/* Lightweight collapsible Task Details */
.task-details-toggle{display:flex;align-items:center;gap:5px;width:max-content;min-height:28px;padding:2px 4px;color:var(--muted);font-size:11px;font-weight:650}
.task-details-toggle .arrow{display:inline-block;transition:transform .15s}
.task-details-toggle[aria-expanded="true"] .arrow{transform:rotate(90deg)}
.task-details-area{display:grid;gap:4px}
.task-details-area textarea{min-height:88px;max-height:180px;resize:vertical;line-height:1.45}
@media(max-width:759px){.task-details-toggle{min-height:36px}.task-details-area textarea{min-height:96px;font-size:16px}}

/* Compact Task Status selector */
.task-status-selector{display:flex;align-items:center;gap:5px;min-height:30px}
.task-status-label{color:var(--muted);font-size:11px;font-weight:650;margin-right:2px}
.task-status-choice{display:inline-flex;align-items:center;justify-content:center;width:30px;height:28px;min-height:28px;padding:0;border:1px solid transparent;border-radius:8px;background:transparent;color:var(--muted);font-size:14px}
.task-status-choice:hover{background:var(--soft);color:var(--ink)}
.task-status-choice.active{border-color:var(--entry-border);background:var(--selected);color:var(--ink);font-weight:700}
@media(max-width:759px){.task-status-selector{min-height:38px}.task-status-choice{width:40px;height:36px;min-height:36px}}

/* Lists are primary navigation; filters are secondary navigation */
.task-toolbar{display:flex;align-items:center;gap:10px;margin-bottom:6px;overflow:hidden}
.task-toolbar .nav-group{display:flex;align-items:center;gap:5px;min-width:0}
.task-toolbar .lists-group{flex:0 1 auto}
.task-toolbar .filters-group{flex:1 1 auto;padding-left:9px;border-left:1px solid var(--line)}
.nav-section-label{flex:0 0 auto;color:#8a9188;font-size:8.5px;font-weight:800;letter-spacing:.08em;line-height:1}
.task-toolbar .list-tabs,.task-toolbar .filters{display:flex;align-items:center;gap:3px;min-width:0;padding:0;border:0;overflow-x:auto}
.task-toolbar .chip{min-height:27px;padding:3px 8px;border:1px solid var(--line);border-radius:8px;background:var(--panel);color:#596057;font-size:11px;font-weight:650;text-decoration:none}
.task-toolbar .chip:hover{background:var(--soft);color:var(--ink)}
.task-toolbar .chip.active{border-color:var(--entry-border);background:var(--selected);color:var(--ink);font-weight:750;text-decoration:none;box-shadow:inset 0 0 0 1px rgba(184,206,194,.18)}
.task-toolbar .filter{min-height:25px;padding:2px 4px;border:0;background:transparent;color:#9aa198;font-size:10.5px;font-weight:500}
.task-toolbar .filter.active{background:transparent;color:var(--ink);font-weight:700;text-decoration:underline;text-underline-offset:4px}
@media(max-width:759px){
.task-toolbar{display:grid!important;grid-template-columns:1fr!important;gap:3px!important;margin-bottom:5px!important;overflow:visible!important;white-space:nowrap}
.task-toolbar .nav-group{display:flex!important;align-items:center!important;gap:4px!important;min-width:0}
.task-toolbar .lists-group,.task-toolbar .filters-group{width:100%;padding:0!important;border:0!important}
.task-toolbar .filters-group{padding-top:3px!important;border-top:1px solid var(--line)!important}
.nav-section-label{width:42px;font-size:8px}
.task-toolbar .list-tabs,.task-toolbar .filters{flex:1 1 auto!important;gap:2px!important;overflow-x:auto!important;padding:0!important;border:0!important}
.task-toolbar .filters:before{display:none!important}
.task-toolbar .chip{min-height:26px!important;height:26px!important;padding:2px 7px!important;border:1px solid var(--line)!important;border-radius:7px!important;background:var(--panel)!important;font-size:10px!important;line-height:20px!important}
.task-toolbar .chip.active{border-color:var(--entry-border)!important;background:var(--selected)!important;color:var(--ink)!important;text-decoration:none!important}
.task-toolbar .filter{min-height:24px!important;height:24px!important;padding:1px 4px!important;border:0!important;border-radius:0!important;background:transparent!important;font-size:10px!important;line-height:22px!important}
}

/* Compact requestor and task-summary capture */
.task-title-entry{display:grid;grid-template-columns:minmax(100px,.38fr) minmax(0,1fr);gap:7px;align-items:end}
.task-title{display:flex;align-items:baseline;gap:5px;min-width:0;white-space:nowrap;overflow:hidden}
.task-title-requestor{flex:0 0 auto;max-width:38%;overflow:hidden;text-overflow:ellipsis;color:#596057;font-weight:750;background:var(--entry);border:1px solid var(--entry-border);border-radius:6px;padding:1px 6px;line-height:1.35}
.task-title-separator{flex:0 0 auto;color:#a3aaa1;font-weight:500}
.task-title-summary{flex:1 1 auto;min-width:0;overflow:hidden;text-overflow:ellipsis}
@media(max-width:759px){.task-title-entry{grid-template-columns:minmax(88px,.36fr) minmax(0,1fr);gap:5px}.task-title-requestor{max-width:42%;padding:1px 5px}}

.task-timestamps{color:#a3aaa1;font-size:9.5px;line-height:1.35;text-align:right;white-space:nowrap}@media(max-width:759px){.task-timestamps{font-size:9px;white-space:normal}}

/* Calendar V3: dense two-up rolling calendar */
.calendar-view{padding:7px 9px 11px}.calendar-layout{display:grid;grid-template-columns:minmax(390px,1.25fr) minmax(270px,.75fr);gap:10px;align-items:start}.calendar-column,.upcoming-column{min-width:0}.calendar-head,.upcoming-head{display:flex;align-items:center;justify-content:space-between;gap:8px;min-height:24px;margin-bottom:4px}.calendar-year{font-size:12px;font-weight:750}.calendar-readonly,.calendar-range{color:var(--muted);font-size:9px}.calendar-months-vertical{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:4px 6px;align-items:start}.calendar-month{min-width:0;border:1px solid var(--line);border-radius:6px;background:#fff;padding:3px 5px}.calendar-month.current-month{border-color:#8fb9df;box-shadow:inset 0 2px 0 #8fb9df}.calendar-month-title{margin-bottom:2px;padding:1px 3px;background:#edf5fc;color:#315f7d;font-size:9.5px;font-weight:750;text-align:left}.calendar-month.current-month .calendar-month-title{background:#cfe7f7}.calendar-weekdays,.calendar-days{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:0}.calendar-weekday{padding:0;color:#858d84;font-size:7px;font-weight:700;line-height:14px;text-align:center}.calendar-day{display:flex;align-items:center;justify-content:center;min-height:15px;padding:0;border:1px solid transparent;border-radius:3px;color:#596057;font-size:8px;line-height:1;text-align:center}.calendar-day.other-month{color:#aab0a9}.calendar-day.today{border-color:#8fb9df}.calendar-day.has-events{border-color:#b9d8ee;background:#dceef9;color:#315f7d;font-weight:800}.calendar-day.has-events.past-event{border-color:#d9e3ea;background:#eef3f6;color:#76838f;font-weight:700}.calendar-day.has-events.today{border-color:#6f9fc2;box-shadow:inset 0 0 0 1px #8fb9df;background:#dceef9;color:#315f7d;font-weight:800}.calendar-day-number{display:block;line-height:1}.calendar-sentinel{grid-column:1/-1;height:1px}.upcoming-column{position:sticky;top:7px}.upcoming-title{font-size:11.5px;font-weight:750}.upcoming-list{display:grid;gap:2px;max-height:calc(100dvh - 142px);overflow-y:auto;overscroll-behavior:contain;padding-right:2px}.upcoming-row{display:grid;grid-template-columns:88px minmax(0,1fr);gap:5px;align-items:center;min-height:24px;padding:2px 4px;border:1px solid var(--line);border-radius:5px;background:#fff}.upcoming-when{display:grid;grid-template-columns:44px 39px;gap:1px;min-width:0;padding-right:2px;border-right:1px solid var(--line);white-space:nowrap}.upcoming-date{font-size:10px;font-weight:700}.upcoming-time{color:var(--muted);font-size:9.5px}.upcoming-task{display:block;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.upcoming-task .task-title{display:block;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.upcoming-task .task-title-requestor{display:inline;max-width:none;padding:0;border:0;background:transparent;color:#596057}.upcoming-task .task-title-separator,.upcoming-task .task-title-summary{display:inline}.calendar-link{margin-left:auto;order:3}.calendar-link.active{background:var(--selected);color:var(--ink);font-weight:700}.head-actions{order:2}
/* Task Groups V1 */
.grouped-toggle{flex:0 0 auto}.grouped-toggle.active{border-color:var(--entry-border)!important;background:var(--selected)!important;color:var(--ink)!important}.task-group-section{display:grid;gap:3px}.task-group-section+.task-group-section{margin-top:6px}.task-group-head{display:flex;align-items:center;min-height:25px;padding:2px 5px;border-top:1px solid var(--line);border-bottom:1px solid var(--line);background:var(--panel)}.task-group-collapse{width:24px;height:22px;min-height:22px;padding:0;border:0;background:transparent;color:var(--muted)}.task-group-name{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;border:0;background:transparent;padding:2px 4px;font-weight:750;text-align:left}.task-group-count{margin-left:auto;color:var(--muted);font-size:9.5px}.group-detail-sections{display:grid;gap:9px}.group-detail-section{display:grid;gap:3px}.group-detail-title{padding-bottom:3px;border-bottom:1px solid var(--line);color:var(--muted);font-size:9px;font-weight:800;letter-spacing:.08em}.group-detail-item{display:grid;grid-template-columns:78px minmax(0,1fr);gap:5px;align-items:center;min-height:30px;padding:3px 5px;border:1px solid var(--line);border-radius:7px;background:#fff;cursor:pointer}.group-detail-item:hover{background:var(--soft)}.group-detail-meta{color:var(--muted);font-size:9.5px;white-space:nowrap}.group-detail-item-title{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.group-empty{padding:9px;color:var(--muted);font-size:10px;text-align:center}
@media(max-width:759px){.calendar-layout{grid-template-columns:1fr}.calendar-months-vertical{grid-template-columns:1fr}.calendar-month{padding:4px 6px}.calendar-day{min-height:22px;font-size:9px}.upcoming-column{position:static}.upcoming-list{max-height:none;overflow:visible}.upcoming-row{grid-template-columns:88px minmax(0,1fr);gap:4px}.upcoming-when{grid-template-columns:44px 39px;gap:1px}.calendar-link{min-height:30px!important}.task-group-head{min-height:34px}.task-group-collapse{width:34px;height:30px;min-height:30px}}

/* Task Groups V1.1 secondary view controls */
.group-viewbar{display:flex;align-items:center;gap:3px;min-height:25px;margin:0 0 6px;padding:2px 0;border-bottom:1px solid var(--line)}.group-view-context{color:var(--muted);font-size:9px;font-weight:750;margin-right:2px}.list-total-count{margin-left:3px;color:#a3aaa1;font-size:9px;font-weight:600}.group-view-btn,.group-action-btn{min-height:23px;padding:2px 6px;border:0;border-radius:6px;background:transparent;color:#8f968d;font-size:10px}.group-view-btn.active{background:var(--selected);color:var(--ink);font-weight:750}.group-bulk-actions{display:flex;align-items:center;gap:2px;margin-left:auto}.group-action-btn{color:var(--muted)}.group-action-btn:hover{background:var(--soft);color:var(--ink)}.note-group-section{display:grid;gap:3px}.note-group-section+.note-group-section{margin-top:6px}.note-group-items{display:grid;gap:3px}
@media(max-width:759px){.group-viewbar{min-height:32px}.group-view-btn,.group-action-btn{min-height:30px;padding:4px 7px}}

/* Subtle Next Action emphasis */
.task-next{display:block;width:max-content;max-width:100%;margin-top:2px;padding:1px 6px;border:1px solid #d7e7db;border-radius:6px;background:#eef7f0;color:#3d5a48;font-size:10px;line-height:1.35;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.task-card.done .task-next{background:#f3f5f3;border-color:#e2e6e2;color:#8a9188}
@media(max-width:759px){.task-next{padding:2px 6px;font-size:10px}}
</style>
</head>
<body>
<div class="toast" id="toast" role="status" aria-live="polite"></div>
<div class="shell">
<header class="app-head"><div class="brand-nav"><nav class="tabs compact-tabs" aria-label="Main sections"><button class="tab active" data-view="tasks">Tasks</button><button class="tab" data-view="notes">Notes</button></nav><div class="head-actions compact-actions"><button class="plain-btn capture-action" id="addTaskBtn">+ Task</button><button class="plain-btn capture-action" id="addNoteBtn">+ Note</button><input class="backup-input" id="importFile" type="file" accept="application/json,.json"></div><button class="plain-btn calendar-link" data-view="calendar">Calendar</button></div></header>
<div class="search-bar" id="searchBar"><input id="searchInput" type="search" placeholder="Search tasks and notes..." autocomplete="off" aria-label="Search tasks and notes"></div><div class="journal-capture" id="journalCapture" hidden><input id="journalText" type="text" maxlength="500" placeholder="Capture a thought..." aria-label="Quick journal entry"><button class="plain-btn" id="cancelJournalBtn">Cancel</button><button class="primary-btn" id="saveJournalBtn">Save</button></div>
<main class="main">
<section class="view" id="tasksView">
<div class="toolbar task-toolbar"><div class="nav-group lists-group"><span class="nav-section-label">LISTS <span class="list-total-count" id="activeTaskCount"></span></span><div class="list-tabs" id="taskLists"></div></div><div class="nav-group filters-group"><span class="nav-section-label">FILTERS</span><div class="filters" id="taskFilters"><button class="filter active" data-filter="all">All</button><button class="filter" data-filter="scheduled">🗓 Scheduled</button><button class="filter" data-filter="no-date">No Date</button><button class="filter" data-filter="started">Started</button><button class="filter" data-filter="waiting">Waiting</button></div></div></div>
<div class="group-viewbar"><span class="group-view-context" id="taskViewContext"></span><button class="group-view-btn active" id="taskAllBtn" type="button">All</button><button class="group-view-btn" id="taskGroupedBtn" type="button">Grouped</button><span class="group-bulk-actions" id="taskGroupActions" hidden><button class="group-action-btn" id="expandGroupsBtn" type="button">Expand All</button><button class="group-action-btn" id="collapseGroupsBtn" type="button">Collapse All</button></span></div><div id="activeFilterIndicator" class="active-filter-indicator" role="status" aria-live="polite"><span id="activeFilterText"></span><button id="clearActiveFilter" type="button" aria-label="Clear active filter" title="Clear active filter">×</button></div><div id="filterHint" style="font-size:10px;color:#6f766d;margin:0 0 4px 2px"></div><div class="list" id="taskList"></div>
</section>
<section class="view" id="notesView" hidden>
<div class="toolbar"><span class="toolbar-title">Notes</span></div><div class="group-viewbar"><button class="group-view-btn active" id="noteAllBtn" type="button">All</button><button class="group-view-btn" id="noteGroupedBtn" type="button">Grouped</button><span class="group-bulk-actions" id="noteGroupActions" hidden><button class="group-action-btn" id="expandNoteGroupsBtn" type="button">Expand All</button><button class="group-action-btn" id="collapseNoteGroupsBtn" type="button">Collapse All</button></span></div>
<div class="notes-list" id="notesList"></div>
</section>
<section class="view calendar-view" id="calendarView" hidden aria-label="Calendar">
<div class="calendar-layout">
<section class="calendar-column" aria-label="Months"><div class="calendar-head"><span class="calendar-year">Calendar</span><span class="calendar-range" id="calendarRange"></span></div><div class="calendar-months-vertical" id="calendarMonths"><div class="calendar-sentinel" id="calendarTopSentinel" aria-hidden="true"></div></div><div class="calendar-sentinel" id="calendarSentinel" aria-hidden="true"></div></section>
<section class="upcoming-column" aria-label="Upcoming Events"><div class="upcoming-head"><span class="upcoming-title">Upcoming Events</span><span class="calendar-readonly">Read-only</span></div><div class="upcoming-list" id="upcomingEvents"></div></section>
</div>
</section>
</main>
<footer class="footer"><span class="footer-actions"><button class="plain-btn" id="reportBtn">Report</button><button class="plain-btn" id="exportBtn">Export</button><button class="plain-btn" id="importBtn">Import</button><button class="plain-btn" id="restoreBtn" hidden>Restore previous backup</button><button class="plain-btn" id="helpBtn">Help</button><button class="plain-btn" id="shortcutsBtn">Keyboard shortcuts</button><button class="plain-btn" id="journalBtn">+ Capture</button><button class="plain-btn" id="todayJournalBtn">Daily Note</button><button class="plain-btn mobile-sticky-btn" id="mobileStickyBtn">Sticky</button><button class="plain-btn archived-footer" id="doneFooterBtn" data-filter="done">Done</button><button class="plain-btn archived-footer" id="archivedFooterBtn" data-filter="archived">Archived</button></span></footer>
</div>

<div class="modal" id="groupDetailModal" aria-hidden="true"><section class="dialog wide" role="dialog" aria-modal="true" aria-labelledby="groupDetailTitle"><div class="dialog-head"><span class="dialog-title" id="groupDetailTitle">Group</span><button class="plain-btn" data-close="groupDetailModal">Close</button></div><div class="dialog-body group-detail-sections" id="groupDetailContent"></div></section></div>
<div class="modal" id="taskModal" aria-hidden="true"><section class="dialog" role="dialog" aria-modal="true" aria-labelledby="taskDialogTitle"><div class="dialog-head"><span class="dialog-title" id="taskDialogTitle">Task</span><div><button class="plain-btn" data-close="taskModal">Cancel</button><button class="plain-btn" id="saveTaskNextBtn">Save + Next</button><button class="primary-btn" id="saveTaskTopBtn">Save</button></div></div><div class="dialog-body">
<div class="task-title-entry"><div class="field-group task-requestor-field"><label for="taskRequestor">Requestor <small>(optional)</small></label><input class="field" id="taskRequestor" maxlength="80" autocomplete="off" placeholder="Name"></div><div class="field-group task-summary-field"><label for="taskTitle">Task summary</label><input class="field" id="taskTitle" maxlength="240" autocomplete="off" placeholder="What needs to be done?"></div></div>
<div class="field-group"><label for="taskNext">Next action <small>(optional)</small></label><input class="field" id="taskNext" maxlength="160" placeholder="What is the very next action?"></div>
<div class="task-status-selector" id="taskStatusSelector" role="group" aria-label="Task status"><span class="task-status-label">Status:</span><button class="task-status-choice" type="button" data-task-status="" title="Not Started" aria-label="Not Started">○</button><button class="task-status-choice" type="button" data-task-status="started" title="Started" aria-label="Started">▶</button><button class="task-status-choice" type="button" data-task-status="waiting" title="Waiting" aria-label="Waiting">⏸</button><button class="task-status-choice" type="button" data-task-status="done" title="Done" aria-label="Done">✓</button></div>
<div class="field-group"><label for="taskListSelect">List</label><select class="field" id="taskListSelect"></select></div><div class="field-group"><label for="taskGroup">Group <small>(optional)</small></label><input class="field" id="taskGroup" list="groupSuggestions" maxlength="120" autocomplete="off" placeholder="None"><datalist id="groupSuggestions"></datalist></div>
<button class="plain-btn task-details-toggle" id="taskDetailsToggle" type="button" aria-expanded="false" aria-controls="taskDetailsArea"><span class="arrow">›</span> More Details</button>
<div class="task-details-area" id="taskDetailsArea" hidden><label for="taskDetails" class="sr-only">Task details</label><textarea class="field" id="taskDetails" maxlength="4000" placeholder="Add context, links, checklist items or supporting information..."></textarea></div>
<div class="task-schedule-row"><div class="field-group"><label for="taskDate">Date</label><input class="field" id="taskDate" type="date"></div><div class="field-group"><label for="taskTime">Time</label><select class="field" id="taskTime"><option value="">No time</option></select></div><div class="field-group task-estimate-field"><label for="taskEstimate">Est. min</label><input class="field" id="taskEstimate" type="number" min="0" step="5" inputmode="numeric" placeholder="30" aria-label="Estimate in minutes"></div></div>
<div class="task-options-row"><label class="check-line"><input id="taskHighlight" type="checkbox"> Highlight Task</label><label class="check-line"><input id="taskEvent" type="checkbox"> Mark as Event</label></div>
<div class="field-group"><label>Note <small>(optional)</small></label><div class="task-note-actions"><button class="plain-btn" id="createTaskNoteBtn" type="button">Create note</button><button class="plain-btn" id="linkTaskNoteBtn" type="button">Link existing</button><button class="plain-btn" id="openTaskNoteBtn" type="button" hidden>Open note</button><button class="plain-btn" id="unlinkTaskNoteBtn" type="button" hidden>Unlink</button><span class="task-note-linked" id="taskNoteLinkedText">No note linked</span></div><select class="field" id="taskNoteSelect" hidden><option value="">None</option></select></div>
</div><div class="dialog-actions"><button class="plain-btn danger" id="deleteTaskBtn">Delete</button><span class="spacer"></span><div class="task-timestamps" id="taskTimestamps" hidden></div></div></section></div>

<div class="modal" id="linkTaskNoteModal" aria-hidden="true"><section class="dialog" role="dialog" aria-modal="true" aria-labelledby="linkTaskNoteTitle"><div class="dialog-head"><span class="dialog-title" id="linkTaskNoteTitle">Link existing note</span><button class="plain-btn" data-close="linkTaskNoteModal">Close</button></div><div class="dialog-body"><div class="field-group"><label for="existingTaskNoteSelect">Note</label><select class="field" id="existingTaskNoteSelect"><option value="">Select a note</option></select></div></div><div class="dialog-actions"><span class="spacer"></span><button class="primary-btn" id="confirmLinkTaskNoteBtn" type="button">Link note</button></div></section></div>
<div class="modal" id="noteModal" aria-hidden="true"><section class="dialog wide" role="dialog" aria-modal="true" aria-labelledby="noteDialogTitle"><div class="dialog-head"><span class="dialog-title" id="noteDialogTitle">Note</span><button class="plain-btn" data-close="noteModal">Close</button></div><div class="dialog-body">
<div class="field-group"><label for="noteTitle">Title</label><input class="field" id="noteTitle" maxlength="160" autocomplete="off"></div><div class="field-group"><label for="noteGroup">Group <small>(optional)</small></label><input class="field" id="noteGroup" list="noteGroupSuggestions" maxlength="120" autocomplete="off" placeholder="None"><datalist id="noteGroupSuggestions"></datalist></div>
<div class="field-group"><label for="noteBody">Content</label><textarea class="field note-body" id="noteBody" placeholder="Write your note. Link another note with [[Note Title]]."></textarea></div>
<label class="check-line"><input id="notePinned" type="checkbox"> Pin note</label>
<div class="related" id="relatedArea" hidden><div class="related-title">Related Notes and Backlinks</div><div class="related-list" id="relatedList"></div></div>
</div><div class="dialog-actions"><button class="plain-btn danger" id="deleteNoteBtn">Delete</button><span class="spacer"></span><button class="plain-btn" id="closeNoteBtn">Close</button></div></section></div>

<div class="modal mobile-sticky-modal" id="mobileStickyModal" aria-hidden="true"><section class="dialog" role="dialog" aria-modal="true" aria-labelledby="mobileStickyTitle"><div class="dialog-head"><span class="dialog-title" id="mobileStickyTitle">Sticky Note</span><button class="plain-btn" id="mobileStickyDoneBtn">Done</button></div><div class="dialog-body"><textarea class="mobile-sticky-text" id="mobileStickyText" placeholder="Temporary reminders and reference notes..." aria-label="Sticky note text"></textarea></div></section></div>
<div class="modal" id="shortcutsModal" aria-hidden="true"><section class="dialog" role="dialog" aria-modal="true" aria-labelledby="shortcutsTitle"><div class="dialog-head"><span class="dialog-title" id="shortcutsTitle">Keyboard shortcuts</span><button class="plain-btn" data-close="shortcutsModal">Close</button></div><div class="dialog-body"><ul class="help"><li><strong>T</strong> New Task</li><li><strong>N</strong> New Note</li><li><strong>C</strong> Capture</li><li><strong>Shift + C</strong> Daily Note</li><li><strong>1</strong> Tasks</li><li><strong>2</strong> Notes</li><li><strong>/</strong> Search</li><li><strong>Alt + D</strong> Insert Date</li><li><strong>Alt + Shift + D</strong> Insert Timestamp</li><li><strong>Alt + Shift + T</strong> Insert Time</li><li><strong>Ctrl + Enter</strong> Save</li></ul></div></section></div>
<div class="modal" id="helpModal" aria-hidden="true"><section class="dialog wide" role="dialog" aria-modal="true" aria-labelledby="helpTitle"><div class="dialog-head"><span class="dialog-title" id="helpTitle">Workspace Guide</span><button class="plain-btn" data-close="helpModal">Close</button></div><div class="dialog-body"><strong>Workspace Philosophy</strong><p>Workspace is inspired by Getting Things Done (GTD). It is designed to capture information quickly, clarify next actions, separate actions from reference material, review commitments regularly, and keep the system lightweight and practical.</p><strong>Tasks</strong><ul class="help"><li>Use tasks for clear actions.</li><li>Add an optional next action, date, time, estimate, highlight or linked note.</li><li>Use Started, Waiting and Done to track progress.</li></ul><strong>Events</strong><p>Use the Event checkbox for appointments, meetings and other commitments. Events use blue styling and can be filtered separately.</p><strong>Scheduled View</strong><p>Review dated commitments using Today and Overdue controls.</p><strong>Notes</strong><p>Use notes for reference information, procedures and meeting notes. Link notes with <code>[[Note Title]]</code>.</p><strong>Capture</strong><p>Capture first and organize later. Use it for ideas, reminders and follow-up items.</p><strong>Daily Note</strong><p>Use Daily Note as a lightweight activity log, decision record and daily history.</p><strong>Sticky Note</strong><p>Use Sticky Note as a temporary scratchpad for information needed right now. It is shared between desktop and mobile, saved automatically and included in backups.</p><strong>Backup Strategy</strong><p>Export regularly and keep backup files. Use Restore Previous Backup when needed.</p><strong>Keyboard Shortcuts</strong><ul class="help"><li><strong>T</strong> New Task</li><li><strong>N</strong> New Note</li><li><strong>C</strong> Capture</li><li><strong>Shift + C</strong> Daily Note</li><li><strong>1 / 2</strong> Tasks / Notes</li><li><strong>/</strong> Search</li><li><strong>Alt + D</strong> Insert Date</li><li><strong>Alt + Shift + D</strong> Insert Timestamp</li><li><strong>Alt + Shift + T</strong> Insert Time</li><li><strong>Ctrl + Enter</strong> Save</li></ul><button class="primary-btn" id="advancedGuideBtn" type="button">Advanced Guide</button></div></section></div>
<div class="modal" id="advancedHelpModal" aria-hidden="true"><section class="dialog wide" role="dialog" aria-modal="true" aria-labelledby="advancedHelpTitle"><div class="dialog-head"><span class="dialog-title" id="advancedHelpTitle">Advanced Guide</span><button class="plain-btn" data-close="advancedHelpModal">Close</button></div><div class="dialog-body"><strong>GTD-Inspired Workflow</strong><ol class="help"><li><strong>Capture:</strong> Record incoming thoughts before they are forgotten.</li><li><strong>Clarify:</strong> Decide whether an item is actionable and identify the next physical action.</li><li><strong>Organize:</strong> Place actions in an appropriate list, schedule true date commitments, and keep reference material in Notes.</li><li><strong>Review:</strong> Check waiting items, scheduled commitments and unfinished work regularly.</li><li><strong>Engage:</strong> Choose the appropriate action based on your available time, energy and priorities.</li></ol><strong>Recommended Workspace Practices</strong><ul class="help"><li>Keep task titles action-oriented and specific.</li><li>Use dates for genuine commitments, not general wishes.</li><li>Use Events for appointments and fixed commitments.</li><li>Use Waiting when progress depends on another person or external condition.</li><li>Use Notes for durable reference material.</li><li>Use Sticky Note only for temporary working information.</li><li>Review Scheduled daily and export backups regularly.</li></ul><strong>System Design Philosophy</strong><p>Workspace is GTD-inspired rather than a strict GTD implementation. Its purpose is to support execution without adding unnecessary structure. If a feature adds complexity without improving execution, it probably does not belong in Workspace.</p><strong>Example Workflow</strong><p>Capture an incoming thought, clarify whether it requires action, create a Task with the next action if needed, add a date only when it represents a real commitment, and move supporting information into a linked Note.</p></div></section></div>
<aside class="sticky-note-panel" id="stickyNotePanel" aria-label="Sticky note">
  <div class="sticky-note-head">
    <span class="sticky-note-title">Sticky Note</span>
    <button class="sticky-note-toggle" id="stickyNoteToggle" type="button" aria-label="Collapse sticky note" title="Collapse sticky note">›</button>
  </div>
  <div class="sticky-note-body">
    <textarea class="sticky-note-text" id="stickyNoteText" placeholder="Temporary reminders and reference notes..." aria-label="Sticky note text"></textarea>
    <div class="sticky-note-status" id="stickyNoteStatus">Saved locally</div>
  </div>
</aside>
<script>
(()=>{'use strict';
const KEY='worktasks:v1';const BACKUP_KEYS=['worktasks:backup1','worktasks:backup2','worktasks:backup3'];
const LISTS=['Inbox','This Week','Later','Someday'];
const $=id=>document.getElementById(id);function buildTimeOptions(){[['taskTime','No time']].forEach(([id,label])=>{const el=$(id);if(!el||el.tagName!=='SELECT')return;let h=`<option value="">${label}</option>`;for(let hh=0;hh<24;hh++){for(let mm=0;mm<60;mm+=15){const v=String(hh).padStart(2,'0')+':'+String(mm).padStart(2,'0');h+=`<option value="${v}">${v}</option>`}}el.innerHTML=h})}
const app={tasks:[],notes:[],activeList:'Inbox',groupedView:false,notesGroupedView:false,collapsedGroups:{},collapsedNoteGroups:{},filter:'all',view:'tasks',estimateOnly:false,notStartedOnly:false,todayOnly:false,overdueOnly:false,highlightedOnly:false,eventMode:'all',stickyNote:''};
let editingTaskId=null,editingNoteId=null,saveTimer=null,noteSaveTimer=null;let reviewNextTaskId=null,editingTaskStatus='';
function id(prefix){return prefix+'-'+Date.now()+'-'+Math.random().toString(16).slice(2)}
function clean(v){return String(v??'').trim()}
function normalize(raw){const out={tasks:[],notes:[],activeList:'Inbox',groupedView:false,collapsedGroups:{},filter:'all',view:'tasks',stickyNote:''};if(!raw||typeof raw!=='object')return out;if(Array.isArray(raw.tasks))out.tasks=raw.tasks.map(t=>({id:clean(t.id)||id('task'),title:clean(t.title),nextAction:clean(t.nextAction),details:String(t.details??''),list:LISTS.includes(t.list)?t.list:'Inbox',date:/^\d{4}-\d{2}-\d{2}$/.test(t.date||'')?t.date:'',time:/^(?:[01]\d|2[0-3]):[0-5]\d$/.test(t.time||'')?t.time:'',archived:Boolean(t.archived),estimate:Number.isFinite(+t.estimate)?Math.max(0,+t.estimate):0,status:['started','waiting','done'].includes(t.status)?t.status:(t.done?'done':''),highlighted:Boolean(t.highlighted),event:Boolean(t.event),noteId:clean(t.noteId),group:clean(t.group),createdAt:t.createdAt||new Date().toISOString(),updatedAt:t.updatedAt||t.createdAt||new Date().toISOString()})).filter(t=>t.title);if(Array.isArray(raw.notes))out.notes=raw.notes.map(n=>({id:clean(n.id)||id('note'),title:clean(n.title)||'Untitled',body:String(n.body??''),pinned:Boolean(n.pinned),group:clean(n.group),createdAt:n.createdAt||new Date().toISOString(),updatedAt:n.updatedAt||n.createdAt||new Date().toISOString()}));out.activeList=LISTS.includes(raw.activeList)?raw.activeList:'Inbox';out.groupedView=Boolean(raw.groupedView);out.notesGroupedView=Boolean(raw.notesGroupedView);out.collapsedGroups=raw.collapsedGroups&&typeof raw.collapsedGroups==='object'?raw.collapsedGroups:{};out.collapsedNoteGroups=raw.collapsedNoteGroups&&typeof raw.collapsedNoteGroups==='object'?raw.collapsedNoteGroups:{};out.filter=['all','started','waiting','scheduled','no-date','done','archived'].includes(raw.filter)?raw.filter:'all';out.view=['tasks','notes','calendar'].includes(raw.view)?raw.view:'tasks';out.estimateOnly=false;out.notStartedOnly=out.filter==='scheduled'&&Boolean(raw.notStartedOnly);out.todayOnly=out.filter==='scheduled'&&Boolean(raw.todayOnly);out.overdueOnly=out.filter==='scheduled'&&Boolean(raw.overdueOnly);out.highlightedOnly=Boolean(raw.highlightedOnly);out.eventMode='all';out.stickyNote=String(raw.stickyNote??'');return out}
function load(){try{Object.assign(app,normalize(JSON.parse(localStorage.getItem(KEY))))}catch(e){Object.assign(app,normalize(null))}}
function updateRestoreButton(){const b=$('restoreBtn');if(b)b.hidden=!BACKUP_KEYS.some(k=>localStorage.getItem(k))}function persist(){const next=JSON.stringify(app),current=localStorage.getItem(KEY);if(current&&current!==next){for(let i=BACKUP_KEYS.length-1;i>0;i--){const previous=localStorage.getItem(BACKUP_KEYS[i-1]);if(previous)localStorage.setItem(BACKUP_KEYS[i],previous)}localStorage.setItem(BACKUP_KEYS[0],current)}localStorage.setItem(KEY,next);updateRestoreButton()}
function toast(text){const el=$('toast');el.textContent=text;el.classList.add('show');clearTimeout(saveTimer);saveTimer=setTimeout(()=>el.classList.remove('show'),1500)}
function escapeHtml(s){return String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
function fmtDate(d){if(!d)return'';const date=new Date(d+'T00:00:00');return date.toLocaleDateString(undefined,{day:'numeric',month:'short',year:date.getFullYear()===new Date().getFullYear()?undefined:'numeric'})}
function fmtTime(t){if(!t)return'';const [h,m]=t.split(':').map(Number);return new Date(2000,0,1,h,m).toLocaleTimeString(undefined,{hour:'numeric',minute:'2-digit'})}
function noteById(noteId){return app.notes.find(n=>n.id===noteId)||null}
function extractLinks(body){const found=[],seen=new Set();for(const m of String(body).matchAll(/\[\[([^\[\]\n]{1,160})\]\]/g)){const title=clean(m[1]);const key=title.toLowerCase();if(title&&!seen.has(key)){seen.add(key);found.push(title)}}return found}
function linkedNote(title){return app.notes.find(n=>n.title.toLowerCase()===title.toLowerCase())||null}
function backlinks(note){return app.notes.filter(n=>n.id!==note.id&&extractLinks(n.body).some(t=>t.toLowerCase()===note.title.toLowerCase()))}
function query(){return clean($('searchInput').value).toLowerCase()}
function splitTaskTitle(title){const value=clean(title),match=value.match(/^([^:\n]{1,80}):\s+(.+)$/);return match?{requestor:clean(match[1]),summary:clean(match[2])}:{requestor:'',summary:value}}
function composeTaskTitle(requestor,summary){requestor=clean(requestor);summary=clean(summary);return requestor?requestor+': '+summary:summary}
function taskTitleHtml(title){const parts=splitTaskTitle(title);return parts.requestor?`<span class="task-title-requestor">${escapeHtml(parts.requestor)}</span><span class="task-title-separator">·</span><span class="task-title-summary">${escapeHtml(parts.summary)}</span>`:`<span class="task-title-summary">${escapeHtml(parts.summary)}</span>`}
function taskSort(a,b){return new Date(b.createdAt)-new Date(a.createdAt)}
function filteredTasks(){const q=query();if(q)return app.tasks.filter(t=>app.filter==='archived'?t.archived:!t.archived).filter(t=>[t.title,t.nextAction,t.details,t.group,noteById(t.noteId)?.title].join(' ').toLowerCase().includes(q)).sort(taskSort);const tasks=app.tasks.filter(t=>t.list===app.activeList).filter(t=>app.filter==='archived'?t.archived:!t.archived).filter(t=>!app.highlightedOnly||t.highlighted).filter(t=>app.filter!=='scheduled'||!app.notStartedOnly||!t.status).filter(t=>app.filter!=='scheduled'||!app.todayOnly||t.date===localDateKey()).filter(t=>app.filter!=='scheduled'||!app.overdueOnly||(t.date && t.date<localDateKey() && t.status!=='done')).filter(t=>app.filter==='started'?t.status==='started':app.filter==='waiting'?t.status==='waiting':app.filter==='done'?t.status==='done':app.filter==='scheduled'?Boolean(t.date):app.filter==='no-date'?!t.date:true);if(app.filter==='scheduled'){return tasks.sort((a,b)=>{const ad=a.date+'T'+(a.time||'23:59');const bd=b.date+'T'+(b.time||'23:59');return ad.localeCompare(bd)});}return tasks.sort(taskSort)}
function renderLists(){const activeTotal=app.tasks.filter(t=>!t.archived).length;const activeCountEl=$('activeTaskCount');if(activeCountEl)activeCountEl.textContent=activeTotal;$('taskLists').innerHTML=LISTS.map(name=>{const count=app.tasks.filter(t=>t.list===name&&!t.archived).length;return `<button class="chip ${name===app.activeList?'active':''}" data-list="${escapeHtml(name)}">${escapeHtml(name)} <span class="count">${count}</span></button>`}).join('')}
function taskFilterCount(filter){const tasks=app.tasks.filter(t=>t.list===app.activeList);if(filter==='archived')return tasks.filter(t=>t.archived).length;const active=tasks.filter(t=>!t.archived);if(filter==='started')return active.filter(t=>t.status==='started').length;if(filter==='waiting')return active.filter(t=>t.status==='waiting').length;if(filter==='done')return active.filter(t=>t.status==='done').length;if(filter==='scheduled')return active.filter(t=>Boolean(t.date)).length;if(filter==='no-date')return active.filter(t=>!t.date).length;return active.length}
function allGroupNames(){return [...new Set([...app.tasks.map(t=>clean(t.group)),...app.notes.map(n=>clean(n.group))].filter(Boolean))].sort((a,b)=>a.localeCompare(b))}
function fillGroupSuggestions(){const html=allGroupNames().map(name=>`<option value="${escapeHtml(name)}"></option>`).join('');$('groupSuggestions').innerHTML=html;$('noteGroupSuggestions').innerHTML=html}
function groupKey(name){return name||'__none__'}
function renderTaskCards(tasks,container){tasks.forEach(t=>{const card=document.createElement('article');card.className='task-card'+(t.status==='done'?' done':'')+(t.highlighted?' highlighted':'')+(t.event?' event':'');const note=noteById(t.noteId);const statusLabel=t.status==='started'?'▶ Started':t.status==='waiting'?'⏸ Waiting':'';const meta=[statusLabel,t.date?fmtDate(t.date):'',t.time?fmtTime(t.time):'',note?'▤ '+note.title:''].filter(Boolean).join(' · ');card.innerHTML=`<button class="task-status" title="Change status" aria-label="Change status">${t.status==='done'?'✓':t.status==='waiting'?'⏸':t.status==='started'?'▶':'○'}</button><button class="task-highlight" title="${t.highlighted?'Remove highlight':'Highlight task'}" aria-label="${t.highlighted?'Remove highlight':'Highlight task'}">${t.highlighted?'★':'☆'}</button><div class="task-main"><div class="task-title">${t.date&&t.time?'⏰ ':''}${taskTitleHtml(t.title)}</div>${t.nextAction?`<div class="task-next">↳ ${escapeHtml(t.nextAction)}</div>`:''}${meta?`<div class="task-meta">${escapeHtml(meta)}</div>`:''}</div><div class="task-actions">${note?`<button class="icon-btn task-note" title="Open linked note" aria-label="Open linked note">▤</button>`:''}<button class="icon-btn archive-task" title="${t.archived?'Restore task':'Archive task'}" aria-label="${t.archived?'Restore task':'Archive task'}">${t.archived?'↩':'▣'}</button><button class="icon-btn secondary-action edit" title="Edit task">✎</button><button class="icon-btn secondary-action danger del" title="Delete task">×</button><button class="icon-btn mobile-edit edit" title="Edit task">›</button></div>`;card.querySelector('.task-status').onclick=()=>{const cycle=['','started','waiting','done'];t.status=cycle[(cycle.indexOf(t.status||'')+1)%cycle.length];t.updatedAt=new Date().toISOString();persist();renderTasks()};card.querySelector('.task-highlight').onclick=()=>{t.highlighted=!t.highlighted;t.updatedAt=new Date().toISOString();persist();renderTasks()};card.querySelector('.archive-task').onclick=()=>{t.archived=!t.archived;t.updatedAt=new Date().toISOString();persist();renderTasks();toast(t.archived?'Task archived':'Task restored')};card.querySelectorAll('.edit').forEach(b=>b.onclick=()=>openTask(t.id));card.querySelector('.del').onclick=()=>removeTask(t.id);const taskNote=card.querySelector('.task-note');if(taskNote)taskNote.onclick=()=>openNote(note.id);card.querySelector('.task-main').onclick=()=>openTask(t.id);container.appendChild(card)})}
function renderGroupedTasks(tasks,list){const groups=new Map();tasks.forEach(t=>{const name=clean(t.group),key=groupKey(name);if(!groups.has(key))groups.set(key,{name:name||'No Group',items:[]});groups.get(key).items.push(t)});const ordered=[...groups.entries()].sort((a,b)=>a[0]==='__none__'?1:b[0]==='__none__'?-1:a[1].name.localeCompare(b[1].name));ordered.forEach(([key,group])=>{const section=document.createElement('section');section.className='task-group-section';const collapsed=Boolean(app.collapsedGroups[key]);section.innerHTML=`<div class="task-group-head"><button class="task-group-collapse" type="button" aria-label="${collapsed?'Expand':'Collapse'} ${escapeHtml(group.name)}">${collapsed?'›':'⌄'}</button><button class="task-group-name" type="button" data-group-name="${escapeHtml(group.name==='No Group'?'':group.name)}" title="Open group details">${escapeHtml(group.name)}</button><span class="task-group-count">${group.items.length}</span></div><div class="list task-group-items"${collapsed?' hidden':''}></div>`;section.querySelector('.task-group-collapse').onclick=()=>{app.collapsedGroups[key]=!collapsed;persist();renderTasks()};section.querySelector('.task-group-name').onclick=()=>openGroupDetail(group.name==='No Group'?'':group.name);renderTaskCards(group.items,section.querySelector('.task-group-items'));list.appendChild(section)})}
function openGroupDetail(name){const taskItems=app.tasks.filter(t=>!t.archived&&clean(t.group)===name),tasks=taskItems.filter(t=>!t.event).sort(taskSort),events=taskItems.filter(t=>t.event).sort((a,b)=>(a.date+'T'+(a.time||'23:59')).localeCompare(b.date+'T'+(b.time||'23:59'))),notes=app.notes.filter(n=>clean(n.group)===name).sort((a,b)=>new Date(b.updatedAt)-new Date(a.updatedAt));$('groupDetailTitle').textContent=name||'No Group';const row=(item,type)=>`<div class="group-detail-item" data-item-id="${escapeHtml(item.id)}" data-item-type="${type}"><span class="group-detail-meta">${type==='event'?[fmtDate(item.date),fmtTime(item.time)].filter(Boolean).join(' '):type==='task'?(item.status||'Task'):'Note'}</span><span class="group-detail-item-title">${type==='note'?escapeHtml(item.title):taskTitleHtml(item.title)}</span></div>`;const section=(title,items,type)=>`<section class="group-detail-section"><div class="group-detail-title">${title.toUpperCase()} (${items.length})</div>${items.length?items.map(x=>row(x,type)).join(''):'<div class="group-empty">None</div>'}</section>`;$('groupDetailContent').innerHTML=section('Tasks',tasks,'task')+section('Events',events,'event')+section('Notes',notes,'note');$('groupDetailContent').querySelectorAll('[data-item-id]').forEach(el=>el.onclick=()=>{closeModal('groupDetailModal');el.dataset.itemType==='note'?openNote(el.dataset.itemId):openTask(el.dataset.itemId)});openModal('groupDetailModal')}
function renderTasks(){renderLists();const filterLabels={all:'All',started:'Started',waiting:'Waiting',scheduled:'🗓 Scheduled','no-date':'No Date',done:'Done',archived:'Archived'};const activeParts=[];if(app.filter!=='all')activeParts.push(filterLabels[app.filter]);if(app.filter==='scheduled'&&app.todayOnly)activeParts.push('Today');if(app.filter==='scheduled'&&app.overdueOnly)activeParts.push('Overdue');if(app.highlightedOnly)activeParts.push('Highlighted');const activeIndicator=$('activeFilterIndicator');$('activeFilterText').textContent=activeParts.length?'Filter: '+activeParts.join(' + '):'';activeIndicator.classList.toggle('visible',activeParts.length>0);document.querySelectorAll('[data-filter]').forEach(b=>{b.classList.toggle('active',b.dataset.filter===app.filter);b.innerHTML=`${filterLabels[b.dataset.filter]} <span class="count">${taskFilterCount(b.dataset.filter)}</span>`});const overdueCount=app.tasks.filter(t=>!t.archived&&t.list===app.activeList&&t.date&&t.date<localDateKey()&&t.status!=='done').length,overdueFilterText=app.overdueOnly?' (filtered)':'',todayCount=app.tasks.filter(t=>!t.archived&&t.list===app.activeList&&t.date===localDateKey()).length,todayFilterText=app.todayOnly?' (filtered)':'',highlightedCount=app.tasks.filter(t=>!t.archived&&t.list===app.activeList&&t.highlighted).length,highlightedFilterText=app.highlightedOnly?' (filtered)':'';const hints={all:'Newest tasks first',started:'Tasks in progress',waiting:'Waiting for someone or something',scheduled:'Scheduled by date/time','no-date':'Tasks without dates',done:'Completed tasks',archived:'Archived tasks'};const searchText=query(),searchHint=searchText?`Searching all lists · ${filteredTasks().length} match${filteredTasks().length===1?'':'es'} · Esc to clear`:'';const highlightedHint=` · <button id="highlightedToggle" style="border:0;background:none;padding:0;color:inherit;cursor:pointer">★ ${highlightedCount} highlighted${highlightedFilterText}</button>`;$('filterHint').innerHTML=searchText?searchHint:app.filter==='scheduled'?`${hints.scheduled} · <button id="todayToggle" style="border:0;background:none;padding:0;color:inherit;cursor:pointer">Today: ${todayCount}${todayFilterText}</button> · <button id="overdueToggle" style="border:0;background:none;padding:0;color:inherit;cursor:pointer">Overdue: ${overdueCount}${overdueFilterText}</button>${highlightedHint}`:`${hints[app.filter]||''}${highlightedHint}`;if(app.filter==='scheduled'){const todayButton=$('todayToggle'),overdueButton=$('overdueToggle');if(todayButton)todayButton.onclick=()=>{app.todayOnly=!app.todayOnly;persist();renderTasks()};if(overdueButton)overdueButton.onclick=()=>{app.overdueOnly=!app.overdueOnly;persist();renderTasks()}}const highlightedButton=$('highlightedToggle');if(highlightedButton)highlightedButton.onclick=()=>{app.highlightedOnly=!app.highlightedOnly;persist();renderTasks()};const list=$('taskList'),tasks=filteredTasks();$('taskViewContext').textContent=app.activeList;$('taskAllBtn').classList.toggle('active',!app.groupedView);$('taskGroupedBtn').classList.toggle('active',app.groupedView);$('taskGroupActions').hidden=!app.groupedView;list.innerHTML='';if(!tasks.length){const q=query();const message=q?'No tasks match the current search and filter.':activeParts.length?'No tasks match this filter.':'No tasks in this list.';list.innerHTML=`<div class="empty">${message}</div>`;return}if(app.groupedView)renderGroupedTasks(tasks,list);else renderTaskCards(tasks,list)}
function filteredNotes(){const q=query();return app.notes.filter(n=>!q||[n.title,n.body,n.group].join(' ').toLowerCase().includes(q)).sort((a,b)=>Number(b.pinned)-Number(a.pinned)||new Date(b.updatedAt)-new Date(a.updatedAt))}
function createNoteRow(n){const row=document.createElement('article'),links=extractLinks(n.body).length,backs=backlinks(n).length;row.className='note-row'+(n.pinned?' pinned':'');row.tabIndex=0;row.innerHTML=`<button class="icon-btn pin" title="${n.pinned?'Unpin note':'Pin note'}">${n.pinned?'★':'☆'}</button><div><div class="note-name">${escapeHtml(n.title)}</div><div class="note-preview">${escapeHtml(clean(n.body).replace(/\s+/g,' ')||'Empty note')}</div></div><div class="note-links">${links+backs?`${links} link${links===1?'':'s'} · ${backs} back`:''}</div>`;row.querySelector('.pin').onclick=e=>{e.stopPropagation();n.pinned=!n.pinned;n.updatedAt=new Date().toISOString();persist();renderNotes()};row.onclick=e=>{if(!e.target.closest('button'))openNote(n.id)};row.onkeydown=e=>{if((e.key==='Enter'||e.key===' ')&&e.target===row){e.preventDefault();openNote(n.id)}};return row}
function renderGroupedNotes(notes,list){const groups=new Map();notes.forEach(n=>{const name=clean(n.group),key=groupKey(name);if(!groups.has(key))groups.set(key,{name:name||'No Group',items:[]});groups.get(key).items.push(n)});const ordered=[...groups.entries()].sort((a,b)=>a[0]==='__none__'?1:b[0]==='__none__'?-1:a[1].name.localeCompare(b[1].name));ordered.forEach(([key,group])=>{const section=document.createElement('section'),collapsed=Boolean(app.collapsedNoteGroups[key]);section.className='note-group-section';section.innerHTML=`<div class="task-group-head"><button class="task-group-collapse" type="button" aria-label="${collapsed?'Expand':'Collapse'} ${escapeHtml(group.name)}">${collapsed?'›':'⌄'}</button><button class="task-group-name" type="button" title="Open group details">${escapeHtml(group.name)}</button><span class="task-group-count">${group.items.length}</span></div><div class="note-group-items"${collapsed?' hidden':''}></div>`;section.querySelector('.task-group-collapse').onclick=()=>{app.collapsedNoteGroups[key]=!collapsed;persist();renderNotes()};section.querySelector('.task-group-name').onclick=()=>openGroupDetail(group.name==='No Group'?'':group.name);const body=section.querySelector('.note-group-items');group.items.forEach(n=>body.appendChild(createNoteRow(n)));list.appendChild(section)})}
function renderNotes(){const list=$('notesList'),notes=filteredNotes();$('noteAllBtn').classList.toggle('active',!app.notesGroupedView);$('noteGroupedBtn').classList.toggle('active',app.notesGroupedView);$('noteGroupActions').hidden=!app.notesGroupedView;list.innerHTML='';if(!notes.length){list.innerHTML='<div class="empty">No matching notes</div>';return}if(app.notesGroupedView){renderGroupedNotes(notes,list);return}notes.forEach(n=>list.appendChild(createNoteRow(n)))}
function calendarEvents(){return app.tasks.filter(t=>!t.archived&&t.event&&t.date).slice().sort((a,b)=>(a.date+'T'+(a.time||'23:59')).localeCompare(b.date+'T'+(b.time||'23:59'))||a.title.localeCompare(b.title))}
let calendarStartMonth=null,calendarEndMonth=null,calendarObserver=null,calendarTopObserver=null;
function monthKey(date){return `${date.getFullYear()}-${String(date.getMonth()+1).padStart(2,'0')}`}
function calendarMonthHtml(year,month,eventDates){const months=['January','February','March','April','May','June','July','August','September','October','November','December'],weekdays=['Mo','Tu','We','Th','Fr','Sa','Su'],first=new Date(year,month,1),daysInMonth=new Date(year,month+1,0).getDate(),mondayOffset=(first.getDay()+6)%7,currentKey=monthKey(new Date()),thisKey=`${year}-${String(month+1).padStart(2,'0')}`,todayKey=localDateKey();let days='';for(let i=0;i<mondayOffset;i++)days+='<span class="calendar-day other-month" aria-hidden="true"></span>';for(let d=1;d<=daysInMonth;d++){const key=`${thisKey}-${String(d).padStart(2,'0')}`,hasEvents=eventDates.has(key),isPastEvent=hasEvents&&key<todayKey;days+=`<span class="calendar-day${hasEvents?' has-events':''}${isPastEvent?' past-event':''}${key===todayKey?' today':''}" aria-label="${months[month]} ${d}, ${year}${hasEvents?', event scheduled':''}"><span class="calendar-day-number">${String(d).padStart(2,'0')}</span></span>`}return `<section class="calendar-month${thisKey===currentKey?' current-month':''}" data-calendar-month="${thisKey}"><div class="calendar-month-title">${months[month]} ${year}</div><div class="calendar-weekdays">${weekdays.map(w=>`<span class="calendar-weekday">${w}</span>`).join('')}</div><div class="calendar-days">${days}</div></section>`}
function updateCalendarRange(){const wrap=$('calendarMonths'),first=wrap?.querySelector('.calendar-month')?.dataset.calendarMonth,last=wrap?.querySelector('.calendar-month:last-of-type')?.dataset.calendarMonth;if(first&&last)$('calendarRange').textContent=first+' to '+last}
function appendCalendarMonths(count=24){const wrap=$('calendarMonths');if(!wrap)return;const eventDates=new Set(calendarEvents().map(t=>t.date));let cursor=calendarEndMonth?new Date(calendarEndMonth.getFullYear(),calendarEndMonth.getMonth()+1,1):new Date(new Date().getFullYear()+4,0,1),html='';for(let i=0;i<count;i++){html+=calendarMonthHtml(cursor.getFullYear(),cursor.getMonth(),eventDates);calendarEndMonth=new Date(cursor);cursor=new Date(cursor.getFullYear(),cursor.getMonth()+1,1)}wrap.insertAdjacentHTML('beforeend',html);updateCalendarRange()}
function prependCalendarMonths(count=24){const wrap=$('calendarMonths'),top=$('calendarTopSentinel'),main=document.querySelector('.main');if(!wrap||!top||!calendarStartMonth)return;const eventDates=new Set(calendarEvents().map(t=>t.date)),oldHeight=main.scrollHeight;let cursor=new Date(calendarStartMonth.getFullYear(),calendarStartMonth.getMonth()-count,1),html='';for(let i=0;i<count;i++){html+=calendarMonthHtml(cursor.getFullYear(),cursor.getMonth(),eventDates);cursor=new Date(cursor.getFullYear(),cursor.getMonth()+1,1)}calendarStartMonth=new Date(calendarStartMonth.getFullYear(),calendarStartMonth.getMonth()-count,1);top.insertAdjacentHTML('afterend',html);main.scrollTop+=main.scrollHeight-oldHeight;updateCalendarRange()}
function initCalendarObservers(){if(calendarObserver)calendarObserver.disconnect();if(calendarTopObserver)calendarTopObserver.disconnect();const bottom=$('calendarSentinel'),top=$('calendarTopSentinel'),main=document.querySelector('.main');if(!bottom||!top)return;calendarObserver=new IntersectionObserver(entries=>{if(app.view==='calendar'&&entries.some(e=>e.isIntersecting))appendCalendarMonths(24)},{root:main,rootMargin:'600px 0px'});calendarTopObserver=new IntersectionObserver(entries=>{if(app.view==='calendar'&&entries.some(e=>e.isIntersecting)&&main.scrollTop<500)prependCalendarMonths(24)},{root:main,rootMargin:'400px 0px 0px'});calendarObserver.observe(bottom);calendarTopObserver.observe(top)}
function positionCurrentCalendarMonth(){const key=monthKey(new Date()),target=document.querySelector(`[data-calendar-month="${key}"]`),main=document.querySelector('.main');if(!target||!main)return;const mainTop=main.getBoundingClientRect().top,targetTop=target.getBoundingClientRect().top;main.scrollTop+=targetTop-mainTop-4}
function renderCalendar(){const now=new Date(),events=calendarEvents(),list=$('upcomingEvents'),wrap=$('calendarMonths');calendarStartMonth=new Date(now.getFullYear()-3,0,1);calendarEndMonth=new Date(now.getFullYear()+3,11,1);const eventDates=new Set(events.map(t=>t.date));let cursor=new Date(calendarStartMonth),html='';while(cursor<=calendarEndMonth){html+=calendarMonthHtml(cursor.getFullYear(),cursor.getMonth(),eventDates);cursor=new Date(cursor.getFullYear(),cursor.getMonth()+1,1)}wrap.innerHTML='<div class="calendar-sentinel" id="calendarTopSentinel" aria-hidden="true"></div>'+html;const upcoming=events.filter(t=>t.date>=localDateKey());list.innerHTML=upcoming.length?upcoming.map(t=>`<div class="upcoming-row" title="${escapeHtml(t.title)}"><span class="upcoming-when"><span class="upcoming-date">${escapeHtml(fmtDate(t.date))}</span><span class="upcoming-time">${escapeHtml(t.time?fmtTime(t.time):'')}</span></span><span class="upcoming-task">${taskTitleHtml(t.title)}</span></div>`).join(''):'<div class="empty">No upcoming events.</div>';updateCalendarRange();requestAnimationFrame(()=>{positionCurrentCalendarMonth();initCalendarObservers()})}
function render(){document.querySelectorAll('[data-view]').forEach(b=>b.classList.toggle('active',b.dataset.view===app.view));$('tasksView').hidden=app.view!=='tasks';$('notesView').hidden=app.view!=='notes';$('calendarView').hidden=app.view!=='calendar';$('searchBar').hidden=app.view==='calendar';if(app.view==='tasks')renderTasks();else if(app.view==='notes')renderNotes();else renderCalendar()}
function openModal(id){$(id).classList.add('open');$(id).setAttribute('aria-hidden','false')}
function closeModal(id){$(id).classList.remove('open');$(id).setAttribute('aria-hidden','true')}
function fillNoteSelect(value=''){$('taskNoteSelect').innerHTML='<option value="">None</option>'+app.notes.slice().sort((a,b)=>a.title.localeCompare(b.title)).map(n=>`<option value="${escapeHtml(n.id)}">${escapeHtml(n.title)}</option>`).join('');$('taskNoteSelect').value=value&&noteById(value)?value:''}
function updateTaskNoteActions(){const note=noteById($('taskNoteSelect').value),has=Boolean(note);$('taskNoteLinkedText').textContent=has?note.title:'No note linked';$('openTaskNoteBtn').hidden=!has;$('unlinkTaskNoteBtn').hidden=!has;$('linkTaskNoteBtn').textContent=has?'Change link':'Link existing'}
function openLinkTaskNote(){const select=$('existingTaskNoteSelect');select.innerHTML='<option value="">Select a note</option>'+app.notes.slice().sort((a,b)=>a.title.localeCompare(b.title)).map(n=>`<option value="${escapeHtml(n.id)}">${escapeHtml(n.title)}</option>`).join('');select.value=$('taskNoteSelect').value&&noteById($('taskNoteSelect').value)?$('taskNoteSelect').value:'';openModal('linkTaskNoteModal')}
function createTaskNote(){const now=new Date(),title=composeTaskTitle($('taskRequestor').value,$('taskTitle').value)||'Untitled';const note={id:id('note'),title,body:'',pinned:false,group:clean($('taskGroup').value),createdAt:now.toISOString(),updatedAt:now.toISOString()};app.notes.push(note);fillNoteSelect(note.id);updateTaskNoteActions();persist();closeModal('taskModal');openNote(note.id);toast('Note created and linked')}
function linkExistingTaskNote(){const noteId=$('existingTaskNoteSelect').value;if(!noteId||!noteById(noteId))return;$('taskNoteSelect').value=noteId;updateTaskNoteActions();closeModal('linkTaskNoteModal');toast('Note linked')}
function openLinkedTaskNote(){const note=noteById($('taskNoteSelect').value);if(!note)return;closeModal('taskModal');openNote(note.id)}
function unlinkTaskNote(){$('taskNoteSelect').value='';updateTaskNoteActions();toast('Note unlinked')}
function setTaskDetailsExpanded(expanded){const area=$('taskDetailsArea'),button=$('taskDetailsToggle');area.hidden=!expanded;button.setAttribute('aria-expanded',String(expanded))}
function toggleTaskDetails(){setTaskDetailsExpanded($('taskDetailsArea').hidden)}
function setTaskStatus(status=''){editingTaskStatus=['','started','waiting','done'].includes(status)?status:'';document.querySelectorAll('[data-task-status]').forEach(b=>{const active=b.dataset.taskStatus===editingTaskStatus;b.classList.toggle('active',active);b.setAttribute('aria-pressed',String(active))})}
function fmtTaskTimestamp(value){const d=new Date(value);return Number.isNaN(d.getTime())?'':d.toLocaleString(undefined,{day:'2-digit',month:'short',year:'numeric',hour:'2-digit',minute:'2-digit'})}
function openTask(taskId=null){editingTaskId=taskId;const t=taskId?app.tasks.find(x=>x.id===taskId):null;$('taskDialogTitle').textContent=t?'Edit Task':'New Task';const titleParts=splitTaskTitle(t?.title||'');$('taskRequestor').value=titleParts.requestor;$('taskTitle').value=titleParts.summary;$('taskNext').value=t?.nextAction||'';$('taskDetails').value=t?.details||'';setTaskStatus(t?.status||'');setTaskDetailsExpanded(Boolean(t?.details));$('taskListSelect').innerHTML=LISTS.map(x=>`<option>${escapeHtml(x)}</option>`).join('');$('taskListSelect').value=t?.list||app.activeList;fillGroupSuggestions();$('taskGroup').value=t?.group||'';$('taskDate').value=t?.date||'';$('taskTime').value=t?.time||'';$('taskEstimate').value=t?.estimate||'';$('taskHighlight').checked=Boolean(t?.highlighted);$('taskEvent').checked=Boolean(t?.event);fillNoteSelect(t?.noteId||'');updateTaskNoteActions();$('deleteTaskBtn').hidden=!t;const timestamps=$('taskTimestamps');timestamps.hidden=!t;timestamps.innerHTML=t?`Created: ${fmtTaskTimestamp(t.createdAt)}<br>Updated: ${fmtTaskTimestamp(t.updatedAt||t.createdAt)}`:'';openModal('taskModal');setTimeout(()=>$('taskTitle').focus(),0)}
function getNextTaskId(currentId){const items=filteredTasks();const idx=items.findIndex(t=>t.id===currentId);return idx>=0&&idx<items.length-1?items[idx+1].id:null}
function saveTask(openNext=false){const nextId=openNext&&editingTaskId?getNextTaskId(editingTaskId):null;const summary=clean($('taskTitle').value),title=composeTaskTitle($('taskRequestor').value,summary);if(!summary){$('taskTitle').focus();return}const time=$('taskTime').value,date=$('taskDate').value;if(time&&!date){alert('Select a date before adding a time.');return}let t=editingTaskId?app.tasks.find(x=>x.id===editingTaskId):null;if(!t){t={id:id('task'),status:'',createdAt:new Date().toISOString(),updatedAt:new Date().toISOString()};app.tasks.push(t)}Object.assign(t,{title,nextAction:clean($('taskNext').value),details:$('taskDetails').value,status:editingTaskStatus,list:$('taskListSelect').value,date,time,estimate:Math.max(0,parseInt($('taskEstimate').value||'0',10)||0),highlighted:$('taskHighlight').checked,event:$('taskEvent').checked,noteId:$('taskNoteSelect').value,group:clean($('taskGroup').value),updatedAt:new Date().toISOString()});persist();render();toast('Task saved');editingTaskId=null;if(nextId){openTask(nextId)}else if(openNext){closeModal('taskModal');toast('Review complete')}else{openTask(null)}}
function removeTask(taskId){const t=app.tasks.find(x=>x.id===taskId);if(!t||!confirm('Delete this task?'))return;app.tasks=app.tasks.filter(x=>x.id!==taskId);persist();closeModal('taskModal');render();toast('Task deleted')}
function localDateKey(d=new Date()){const y=d.getFullYear(),m=String(d.getMonth()+1).padStart(2,'0'),day=String(d.getDate()).padStart(2,'0');return `${y}-${m}-${day}`}function localTimeLabel(d=new Date()){return d.toLocaleTimeString(undefined,{hour:'2-digit',minute:'2-digit'})}function openTodayJournal(){const now=new Date(),title=`${localDateKey(now)} Daily Note`;let note=app.notes.find(n=>n.title===title);if(!note){note={id:id('note'),title,body:'',pinned:false,group:'',createdAt:now.toISOString(),updatedAt:now.toISOString()};app.notes.push(note);persist()}app.view='notes';render();openNote(note.id)}function openJournal(){$('journalCapture').hidden=false;$('journalText').value='';setTimeout(()=>$('journalText').focus(),0)}function closeJournal(){$('journalCapture').hidden=true;$('journalText').value=''}function saveJournal(){const text=clean($('journalText').value);if(!text){$('journalText').focus();return}const now=new Date(),title=`${localDateKey(now)} Daily Note`;let note=app.notes.find(n=>n.title===title);const entry=`• ${text}  ·  ${localTimeLabel(now)}`;if(!note){note={id:id('note'),title,body:entry,pinned:false,group:'',createdAt:now.toISOString(),updatedAt:now.toISOString()};app.notes.push(note)}else{note.body=(note.body?note.body+'\n':'')+entry;note.updatedAt=now.toISOString()}persist();closeJournal();if(app.view==='notes')renderNotes();toast('Capture saved')}
function openNote(noteId=null){editingNoteId=noteId;const n=noteId?noteById(noteId):null;$('noteDialogTitle').textContent=n?'Edit Note':'New Note';$('noteTitle').value=n?.title||'';fillGroupSuggestions();$('noteGroup').value=n?.group||'';$('noteBody').value=n?.body||'';$('notePinned').checked=Boolean(n?.pinned);$('deleteNoteBtn').hidden=!n;renderRelated(n);openModal('noteModal');setTimeout(()=>$('noteTitle').focus(),0)}
function renderRelated(note){const area=$('relatedArea'),list=$('relatedList');list.innerHTML='';if(!note){area.hidden=true;return}const rows=[];extractLinks($('noteBody').value).forEach(title=>rows.push({kind:'Link',title,target:linkedNote(title)}));backlinks(note).forEach(n=>rows.push({kind:'Backlink',title:n.title,target:n}));area.hidden=!rows.length;rows.forEach(r=>{const div=document.createElement('div');div.className='related-item';div.innerHTML=`<span>${escapeHtml(r.kind)}: ${escapeHtml(r.title)}${r.target?'':' (not found)'}</span>`;if(r.target){const b=document.createElement('button');b.className='plain-btn related-open';b.textContent='Open';b.onclick=()=>{saveNote(false);openNote(r.target.id)};div.appendChild(b)}list.appendChild(div)})}
function saveNote(close=false){clearTimeout(noteSaveTimer);const enteredTitle=clean($('noteTitle').value),body=$('noteBody').value,pinned=$('notePinned').checked;let n=editingNoteId?noteById(editingNoteId):null;if(!n&&!enteredTitle&&!clean(body)&&!pinned){if(close){closeModal('noteModal');render()}return false}const title=enteredTitle||'Untitled';if(!n){n={id:id('note'),createdAt:new Date().toISOString()};app.notes.push(n);editingNoteId=n.id}Object.assign(n,{title,body,pinned,group:clean($('noteGroup').value),updatedAt:new Date().toISOString()});persist();if(close){closeModal('noteModal');render()}return true}function scheduleNoteSave(){clearTimeout(noteSaveTimer);noteSaveTimer=setTimeout(()=>{if($('noteModal').classList.contains('open'))saveNote(false)},2000)}function closeNote(){saveNote(true)}
function removeNote(noteId){const n=noteById(noteId);if(!n||!confirm('Delete this note? Task links to it will be removed.'))return;app.tasks.forEach(t=>{if(t.noteId===noteId)t.noteId=''});app.notes=app.notes.filter(x=>x.id!==noteId);persist();closeModal('noteModal');render();toast('Note deleted')}
function restorePreviousBackup(){const raw=localStorage.getItem(BACKUP_KEYS[0]);if(!raw){alert('No previous backup is available.');updateRestoreButton();return}let restored;try{restored=normalize(JSON.parse(raw))}catch(e){alert('The previous backup could not be restored.');return}if(!confirm('Restore the previous automatic backup? Your current data will be kept as the newest backup.'))return;const current=localStorage.getItem(KEY);if(current)localStorage.setItem(BACKUP_KEYS[0],current);Object.assign(app,restored);localStorage.setItem(KEY,JSON.stringify(app));$('searchInput').value='';render();refreshStickyEditors();updateRestoreButton();toast('Previous backup restored')}
function reportDate(value){const d=new Date(value);return Number.isNaN(d.getTime())?'':d.toLocaleDateString(undefined,{day:'2-digit',month:'short',year:'numeric'})}
function exportReport(){const statusOrder={'':0,started:1,waiting:2,done:3},statusLabel={'':'Not Started',started:'Started',waiting:'Waiting',done:'Done'};const tasks=app.tasks.filter(t=>!t.archived).slice().sort((a,b)=>LISTS.indexOf(a.list)-LISTS.indexOf(b.list)||(statusOrder[a.status||'']-statusOrder[b.status||''])||(new Date(b.updatedAt||b.createdAt)-new Date(a.updatedAt||a.createdAt))||a.title.localeCompare(b.title));const lines=['List,Requestor,Task,Status,Last Updated'];tasks.forEach(t=>{const parts=splitTaskTitle(t.title),csv=value=>'"'+String(value??'').replace(/"/g,'""').replace(/[\r\n]+/g,' ')+'"';lines.push([t.list,csv(parts.requestor),csv(parts.summary),statusLabel[t.status||''],reportDate(t.updatedAt||t.createdAt)].join(','))});if(!tasks.length)lines.push('No active tasks');const blob=new Blob([lines.join('\n')],{type:'text/csv;charset=utf-8'}),url=URL.createObjectURL(blob),a=document.createElement('a');a.href=url;a.download='workspace-report-'+localDateKey()+'.csv';document.body.appendChild(a);a.click();a.remove();URL.revokeObjectURL(url);toast('Report downloaded')}
function exportData(){const data={app:'Workspace',version:1,exportedAt:new Date().toISOString(),data:app};const blob=new Blob([JSON.stringify(data,null,2)],{type:'application/json'}),url=URL.createObjectURL(blob),a=document.createElement('a');a.href=url;a.download='work-tasks-backup-'+new Date().toISOString().slice(0,10)+'.json';document.body.appendChild(a);a.click();a.remove();URL.revokeObjectURL(url)}
function importData(file){const reader=new FileReader();reader.onload=()=>{try{const parsed=JSON.parse(String(reader.result||''));if(parsed?.app!=='Workspace'||!parsed.data)throw new Error('Invalid backup');if(!confirm('Replace current Tasks and Notes with this backup?'))return;Object.assign(app,normalize(parsed.data));persist();$('searchInput').value='';render();refreshStickyEditors();toast('Backup imported')}catch(e){alert('This is not a valid Work Tasks backup.')}};reader.onerror=()=>alert('Could not read the backup file.');reader.readAsText(file)}
document.querySelectorAll('[data-view]').forEach(b=>b.onclick=()=>{app.view=b.dataset.view;if(app.view!=='tasks'){app.estimateOnly=false;app.notStartedOnly=false;app.todayOnly=false;app.overdueOnly=false;app.eventMode='all'}persist();render()});$('taskAllBtn').onclick=()=>{app.groupedView=false;persist();renderTasks()};$('taskGroupedBtn').onclick=()=>{app.groupedView=true;persist();renderTasks()};$('expandGroupsBtn').onclick=()=>{app.collapsedGroups={};persist();renderTasks()};$('collapseGroupsBtn').onclick=()=>{const state={};filteredTasks().forEach(t=>state[groupKey(clean(t.group))]=true);app.collapsedGroups=state;persist();renderTasks()};$('noteAllBtn').onclick=()=>{app.notesGroupedView=false;persist();renderNotes()};$('noteGroupedBtn').onclick=()=>{app.notesGroupedView=true;persist();renderNotes()};$('expandNoteGroupsBtn').onclick=()=>{app.collapsedNoteGroups={};persist();renderNotes()};$('collapseNoteGroupsBtn').onclick=()=>{const state={};filteredNotes().forEach(n=>state[groupKey(clean(n.group))]=true);app.collapsedNoteGroups=state;persist();renderNotes()};$('taskLists').onclick=e=>{const b=e.target.closest('[data-list]');if(b){app.activeList=b.dataset.list;persist();renderTasks()}};$('clearActiveFilter').onclick=()=>{app.filter='all';app.estimateOnly=false;app.notStartedOnly=false;app.todayOnly=false;app.overdueOnly=false;app.highlightedOnly=false;app.eventMode='all';persist();renderTasks()};$('taskFilters').onclick=e=>{const b=e.target.closest('[data-filter]');if(b){app.filter=b.dataset.filter;if(app.filter!=='scheduled'){app.estimateOnly=false;app.notStartedOnly=false;app.todayOnly=false;app.overdueOnly=false;app.eventMode='all'}persist();renderTasks()}};$('doneFooterBtn').onclick=()=>{app.view='tasks';app.filter='done';app.estimateOnly=false;app.notStartedOnly=false;app.todayOnly=false;app.overdueOnly=false;app.eventMode='all';persist();render()};$('archivedFooterBtn').onclick=()=>{app.view='tasks';app.filter='archived';app.estimateOnly=false;app.notStartedOnly=false;app.todayOnly=false;app.overdueOnly=false;app.eventMode='all';persist();render()};$('addTaskBtn').onclick=()=>openTask();$('addNoteBtn').onclick=()=>openNote();$('createTaskNoteBtn').onclick=createTaskNote;$('linkTaskNoteBtn').onclick=openLinkTaskNote;$('confirmLinkTaskNoteBtn').onclick=linkExistingTaskNote;$('openTaskNoteBtn').onclick=openLinkedTaskNote;$('unlinkTaskNoteBtn').onclick=unlinkTaskNote;document.querySelectorAll('[data-task-status]').forEach(b=>b.onclick=()=>setTaskStatus(b.dataset.taskStatus));$('taskDetailsToggle').onclick=toggleTaskDetails;$('saveTaskTopBtn').onclick=()=>saveTask(false);$('saveTaskNextBtn').onclick=()=>saveTask(true);$('deleteTaskBtn').onclick=()=>removeTask(editingTaskId);$('closeNoteBtn').onclick=closeNote;$('deleteNoteBtn').onclick=()=>removeNote(editingNoteId);$('noteTitle').addEventListener('input',scheduleNoteSave);$('notePinned').addEventListener('change',scheduleNoteSave);$('noteBody').addEventListener('input',()=>{const n=editingNoteId?noteById(editingNoteId):null;renderRelated(n);scheduleNoteSave()});$('searchInput').addEventListener('input',render);$('reportBtn').onclick=exportReport;$('exportBtn').onclick=exportData;$('importBtn').onclick=()=>{$('importFile').value='';$('importFile').click()};$('restoreBtn').onclick=restorePreviousBackup;$('importFile').onchange=()=>{const f=$('importFile').files?.[0];if(f)importData(f)};$('helpBtn').onclick=()=>openModal('helpModal');$('advancedGuideBtn').onclick=()=>openModal('advancedHelpModal');$('shortcutsBtn').onclick=()=>openModal('shortcutsModal');$('journalBtn').onclick=openJournal;$('todayJournalBtn').onclick=openTodayJournal;$('saveJournalBtn').onclick=saveJournal;$('cancelJournalBtn').onclick=closeJournal;$('journalText').addEventListener('keydown',e=>{if(e.key==='Enter'){e.preventDefault();saveJournal()}else if(e.key==='Escape'){e.preventDefault();closeJournal()}});document.querySelectorAll('[data-close]').forEach(b=>b.onclick=()=>b.dataset.close==='noteModal'?closeNote():closeModal(b.dataset.close));document.querySelectorAll('.modal').forEach(m=>m.onclick=e=>{if(e.target===m)(m.id==='noteModal'?closeNote():closeModal(m.id))});document.addEventListener('keydown',e=>{if(e.key==='Escape'){const openModals=document.querySelectorAll('.modal.open');if(openModals.length){openModals.forEach(m=>m.id==='noteModal'?closeNote():closeModal(m.id));return}const search=$('searchInput');if(search.value){e.preventDefault();search.value='';search.blur();render();return}}if(e.key==='Enter'&&e.ctrlKey){if($('taskModal').classList.contains('open'))saveTask();else if($('noteModal').classList.contains('open'))saveNote(true);else if(!$('journalCapture').hidden)saveJournal()}});function insertAtCursor(el,text){if(!el)return;const start=el.selectionStart??el.value.length;const end=el.selectionEnd??start;el.value=el.value.slice(0,start)+text+el.value.slice(end);const pos=start+text.length;if(el.setSelectionRange)el.setSelectionRange(pos,pos);el.dispatchEvent(new Event('input',{bubbles:true}))}
function dateText(){return new Date().toLocaleDateString(undefined,{day:'2-digit',month:'short',year:'numeric'})}
function timeText(){return new Date().toLocaleTimeString(undefined,{hour:'2-digit',minute:'2-digit'})}
document.addEventListener('keydown',e=>{const tag=(e.target&&e.target.tagName||'').toLowerCase();const typing=['input','textarea','select'].includes(tag);if(e.key==='/'&&!typing){e.preventDefault();$('searchInput').focus();$('searchInput').select();return;}if(typing){if(e.code==='KeyD'&&e.altKey&&e.shiftKey){e.preventDefault();insertAtCursor(e.target,dateText()+' '+timeText());return;}if(e.code==='KeyT'&&e.altKey&&e.shiftKey){e.preventDefault();insertAtCursor(e.target,timeText());return;}if(e.code==='KeyD'&&e.altKey&&!e.shiftKey){e.preventDefault();insertAtCursor(e.target,dateText());return;}return;}if(e.key==='t'||e.key==='T'){if(document.querySelector('.modal.open'))return;e.preventDefault();openTask();return;}if(e.key==='n'||e.key==='N'){if(document.querySelector('.modal.open'))return;e.preventDefault();openNote();return;}if(e.code==='KeyC'&&e.shiftKey){if(document.querySelector('.modal.open'))return;e.preventDefault();openTodayJournal();return;}if(e.code==='KeyC'&&!e.shiftKey){if(document.querySelector('.modal.open'))return;e.preventDefault();openJournal();return;}if(e.key==='1'){e.preventDefault();app.view='tasks';persist();render();return;}if(e.key==='2'){e.preventDefault();app.view='notes';persist();render();return;}});
buildTimeOptions();load();app.view='tasks';app.activeList='This Week';app.filter='all';app.estimateOnly=false;app.notStartedOnly=false;app.todayOnly=false;app.overdueOnly=false;app.highlightedOnly=false;app.eventMode='all';render();updateRestoreButton();

const LEGACY_STICKY_NOTE_KEY='worktasks:sticky-note';
const STICKY_NOTE_COLLAPSED_KEY='worktasks:sticky-note-collapsed';
let stickySaveTimer=null;
function refreshStickyEditors(){const text=$('stickyNoteText'),mobileText=$('mobileStickyText'),value=app.stickyNote||'';if(text&&text.value!==value)text.value=value;if(mobileText&&mobileText.value!==value)mobileText.value=value}
function saveSticky(value){app.stickyNote=value;refreshStickyEditors();persist()}
function initStickyNote(){const panel=$('stickyNotePanel'),toggle=$('stickyNoteToggle'),text=$('stickyNoteText'),status=$('stickyNoteStatus'),mobileText=$('mobileStickyText'),mobileButton=$('mobileStickyBtn'),mobileDone=$('mobileStickyDoneBtn');const legacy=localStorage.getItem(LEGACY_STICKY_NOTE_KEY);if(!app.stickyNote&&legacy){app.stickyNote=legacy;persist();localStorage.removeItem(LEGACY_STICKY_NOTE_KEY)}refreshStickyEditors();if(panel&&toggle&&text){const applyState=()=>{const collapsed=panel.classList.contains('collapsed');toggle.textContent=collapsed?'‹':'›';toggle.setAttribute('aria-label',collapsed?'Expand sticky note':'Collapse sticky note');toggle.title=collapsed?'Expand sticky note':'Collapse sticky note'};if(localStorage.getItem(STICKY_NOTE_COLLAPSED_KEY)==='true')panel.classList.add('collapsed');applyState();toggle.onclick=()=>{panel.classList.toggle('collapsed');localStorage.setItem(STICKY_NOTE_COLLAPSED_KEY,String(panel.classList.contains('collapsed')));applyState();if(!panel.classList.contains('collapsed'))text.focus()};text.oninput=()=>{saveSticky(text.value);if(status)status.textContent='Saved locally'}}if(mobileText)mobileText.oninput=()=>saveSticky(mobileText.value);if(mobileButton)mobileButton.onclick=()=>{refreshStickyEditors();openModal('mobileStickyModal');setTimeout(()=>mobileText&&mobileText.focus(),0)};if(mobileDone)mobileDone.onclick=()=>{if(mobileText)saveSticky(mobileText.value);closeModal('mobileStickyModal')}}
initStickyNote();
})();
</script>


</body>
</html>
